@model Portal.ViewModels.PaginationViewModel

@if (Model.TotalPages > 1)
{
    <div class="@Model.CssClass">
        @if (Model.ShowSummary && Model.TotalCount > 0)
        {
            var effectivePage = Model.TotalPages > 0
                ? Math.Min(Math.Max(1, Model.CurrentPage), Model.TotalPages)
                : 1;
            var from = (effectivePage - 1) * Model.PageSize + 1;
            var to = Math.Min(effectivePage * Model.PageSize, Model.TotalCount);
            <div class="text-center text-muted small mb-2">
                Showing @from–@to of @Model.TotalCount.ToString("N0")
            </div>
        }
        <nav aria-label="@Model.AriaLabel">
            <ul class="pagination @(Model.Small ? "pagination-sm" : "") justify-content-center mb-0">
                <li class="page-item @(!Model.HasPrevious ? "disabled" : "")">
                    <a class="page-link" href="@(Model.HasPrevious ? Model.PageUrl(1) : "#")" aria-label="First" tabindex="@(Model.HasPrevious ? null : -1)">
                        <i class="bi bi-chevron-double-left"></i>
                    </a>
                </li>
                <li class="page-item @(!Model.HasPrevious ? "disabled" : "")">
                    <a class="page-link" href="@(Model.HasPrevious ? Model.PageUrl(Model.CurrentPage - 1) : "#")" aria-label="Previous" tabindex="@(Model.HasPrevious ? null : -1)">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>

                @for (var i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" href="@Model.PageUrl(i)">@i</a>
                    </li>
                }

                <li class="page-item @(!Model.HasNext ? "disabled" : "")">
                    <a class="page-link" href="@(Model.HasNext ? Model.PageUrl(Model.CurrentPage + 1) : "#")" aria-label="Next" tabindex="@(Model.HasNext ? null : -1)">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
                <li class="page-item @(!Model.HasNext ? "disabled" : "")">
                    <a class="page-link" href="@(Model.HasNext ? Model.PageUrl(Model.TotalPages) : "#")" aria-label="Last" tabindex="@(Model.HasNext ? null : -1)">
                        <i class="bi bi-chevron-double-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    </div>
}
