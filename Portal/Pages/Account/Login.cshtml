@page
@model Portal.Pages.Account.LoginModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Login";
}

<img src="~/Resources/mlogo.jpeg" alt="Methodist University Ghana Logo" class="logo-img mb-4" />
<h1 class="h4 fw-bold">Sign in</h1>
<p class="text-muted">to continue to Methodist University Asset Portal</p>
<p class="values">Excellence • Morality • Service</p>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form method="post" id="loginForm" novalidate>
    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
    <div class="form-group mb-3">
        <input asp-for="Input.Email" class="form-control form-control-lg" placeholder="Email" autocomplete="username" />
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>
    <div class="form-group mb-3 position-relative">
        <input asp-for="Input.Password" class="form-control form-control-lg password-input" placeholder="Password" id="passwordInput" autocomplete="current-password" />
        <span asp-validation-for="Input.Password" class="text-danger"></span>
        <button type="button"
                class="password-toggle password-toggle--visible"
                onclick="togglePassword()"
                aria-label="Hide password"
                aria-pressed="true">
            <svg class="password-toggle__icon password-toggle__icon--show" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M2.25 12s3.75-6.75 9.75-6.75S21.75 12 21.75 12 18 18.75 12 18.75 2.25 12 2.25 12Z" />
                <circle cx="12" cy="12" r="3" />
            </svg>
            <svg class="password-toggle__icon password-toggle__icon--hide" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M3 3l18 18" />
                <path d="M10.58 10.58A3 3 0 0 0 13.42 13.42" />
                <path d="M9.88 5.53A9.36 9.36 0 0 1 12 5.25c6 0 9.75 6.75 9.75 6.75a17.7 17.7 0 0 1-2.94 3.72" />
                <path d="M6.61 6.61C3.83 8.43 2.25 12 2.25 12S6 18.75 12 18.75a9.5 9.5 0 0 0 4.46-1.12" />
            </svg>
        </button>
    </div>
    <div class="form-check mb-4">
        <input asp-for="Input.RememberMe" class="form-check-input" />
        <label asp-for="Input.RememberMe" class="form-check-label">Remember me on this computer</label>
    </div>
    <div class="d-grid">
        <button type="submit" class="btn btn-primary btn-lg button" id="signinButton" aria-live="polite">
            <span class="button__text">Sign in</span>
        </button>
    </div>
</form>

<div class="text-center mt-4">
    <a asp-page="/Account/ForgotPassword" class="text-primary text-decoration-none">Forgot password?</a>
    <p class="mt-3">
        Need an account?
        <a asp-page="/Account/Register" class="text-primary text-decoration-none">Create account</a>
    </p>
</div>

@section Scripts {
    <script>
        function togglePassword() {
            const passwordInput = document.getElementById('passwordInput');
            const toggleIcon = document.querySelector('.password-toggle');
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                toggleIcon.classList.remove('password-toggle--visible');
                toggleIcon.setAttribute('aria-label', 'Show password');
                toggleIcon.setAttribute('aria-pressed', 'false');
            } else {
                passwordInput.type = 'password';
                toggleIcon.classList.add('password-toggle--visible');
                toggleIcon.setAttribute('aria-label', 'Hide password');
                toggleIcon.setAttribute('aria-pressed', 'true');
            }
        }

        (function () {
            const form = document.getElementById('loginForm');
            const btn = document.getElementById('signinButton');

            if (!form || !btn) return;

            form.addEventListener('submit', function () {
                if (!form.checkValidity()) {
                    return;
                }

                btn.classList.add('button--loading');
                btn.disabled = true;
            });
        })();
    </script>
    <partial name="_ValidationScriptsPartial" />
}
