@page
@model Portal.Pages.Account.ResetPasswordModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Reset Password";
}

<!-- Logo -->
<img src="~/Resources/mlogo.jpeg" alt="Methodist University Ghana Logo" class="logo-img mb-4" />
<h1 class="h4 fw-bold">Create new password</h1>
<p class="text-muted">Please enter your new password below.</p>
<p class="values">Excellence • Morality • Service</p>

<!-- Success Message -->
@if (Model.SuccessMessage != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @Model.SuccessMessage
        <div class="mt-2">
            <a asp-page="/Account/Login" class="btn btn-success btn-sm">Login now</a>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Error Message -->
@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Reset Password Form -->
@if (!Model.IsSuccess)
{
    <form method="post" id="resetPasswordForm" novalidate>
        <input type="hidden" asp-for="Input.Email" />
        <input type="hidden" asp-for="Input.Token" />

        <div class="form-group mb-3">
            <label asp-for="Input.NewPassword" class="form-label">New Password</label>
            <div class="position-relative">
                <input asp-for="Input.NewPassword" class="form-control form-control-lg password-input"
                       placeholder="Enter new password" id="newPasswordInput" autocomplete="new-password" />
                <button type="button"
                        class="password-toggle password-toggle--visible"
                        onclick="togglePassword(this, 'newPasswordInput')"
                        aria-label="Hide password"
                        aria-pressed="true">
                    <svg class="password-toggle__icon password-toggle__icon--show" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M2.25 12s3.75-6.75 9.75-6.75S21.75 12 21.75 12 18 18.75 12 18.75 2.25 12 2.25 12Z" />
                        <circle cx="12" cy="12" r="3" />
                    </svg>
                    <svg class="password-toggle__icon password-toggle__icon--hide" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M3 3l18 18" />
                        <path d="M10.58 10.58A3 3 0 0 0 13.42 13.42" />
                        <path d="M9.88 5.53A9.36 9.36 0 0 1 12 5.25c6 0 9.75 6.75 9.75 6.75a17.7 17.7 0 0 1-2.94 3.72" />
                        <path d="M6.61 6.61C3.83 8.43 2.25 12 2.25 12S6 18.75 12 18.75a9.5 9.5 0 0 0 4.46-1.12" />
                    </svg>
                </button>
            </div>
            <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
            <div class="form-text">
                Password must be at least 6 characters long.
            </div>
        </div>

        <div class="form-group mb-4">
            <label asp-for="Input.ConfirmPassword" class="form-label">Confirm Password</label>
            <div class="position-relative">
                <input asp-for="Input.ConfirmPassword" class="form-control form-control-lg password-input"
                       placeholder="Confirm new password" id="confirmPasswordInput" autocomplete="new-password" />
                <button type="button"
                        class="password-toggle password-toggle--visible"
                        onclick="togglePassword(this, 'confirmPasswordInput')"
                        aria-label="Hide password"
                        aria-pressed="true">
                    <svg class="password-toggle__icon password-toggle__icon--show" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M2.25 12s3.75-6.75 9.75-6.75S21.75 12 21.75 12 18 18.75 12 18.75 2.25 12 2.25 12Z" />
                        <circle cx="12" cy="12" r="3" />
                    </svg>
                    <svg class="password-toggle__icon password-toggle__icon--hide" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M3 3l18 18" />
                        <path d="M10.58 10.58A3 3 0 0 0 13.42 13.42" />
                        <path d="M9.88 5.53A9.36 9.36 0 0 1 12 5.25c6 0 9.75 6.75 9.75 6.75a17.7 17.7 0 0 1-2.94 3.72" />
                        <path d="M6.61 6.61C3.83 8.43 2.25 12 2.25 12S6 18.75 12 18.75a9.5 9.5 0 0 0 4.46-1.12" />
                    </svg>
                </button>
            </div>
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
        </div>

        <div class="d-grid mb-3">
            <button type="submit" class="btn btn-primary btn-lg button" id="submitButton">
                <span class="button__text">Reset password</span>
            </button>
        </div>

        <div class="text-center">
            <a asp-page="/Account/Login" class="text-primary text-decoration-none">Back to login</a>
        </div>
    </form>
}

@section Scripts {
    <script>
        function togglePassword(toggleIcon, inputId) {
            const passwordInput = document.getElementById(inputId);
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                toggleIcon.classList.remove('password-toggle--visible');
                toggleIcon.setAttribute('aria-label', 'Show password');
                toggleIcon.setAttribute('aria-pressed', 'false');
            } else {
                passwordInput.type = 'password';
                toggleIcon.classList.add('password-toggle--visible');
                toggleIcon.setAttribute('aria-label', 'Hide password');
                toggleIcon.setAttribute('aria-pressed', 'true');
            }
        }

        (function () {
            const form = document.getElementById('resetPasswordForm');
            const btn = document.getElementById('submitButton');

            if (!form || !btn) return;

            form.addEventListener('submit', function (e) {
                if (!form.checkValidity()) {
                    return;
                }

                // Add loading state
                btn.classList.add('button--loading');
                btn.disabled = true;
            }, { passive: true });
        })();
    </script>
    <partial name="_ValidationScriptsPartial" />
}