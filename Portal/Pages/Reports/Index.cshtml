@page
@model Portal.Pages.Reports.IndexModel
@{
    ViewData["Title"] = "Reports";
}

<div class="container-fluid">
    <h1 class="mb-4">Reports Dashboard</h1>

    <!-- Status Messages -->
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @Model.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-3">
        @if (Model.IsAdmin)
        {
            <div class="col-12">
                <div class="card report-query-panel">
                    <div class="card-header bg-dark text-white d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <h5 class="mb-0"><i class="bi bi-stars me-2"></i>Ask Reports</h5>
                        <span class="badge @(Model.IsAiConnected ? "bg-success" : "bg-warning text-dark")">
                            <i class="bi @(Model.IsAiConnected ? "bi-check-circle" : "bi-exclamation-triangle") me-1"></i>
                            @(Model.IsAiConnected ? "AI ready" : "Limited mode")
                        </span>
                    </div>
                    <div class="card-body">
                        <form method="post" asp-page-handler="ProcessQuery" class="ai-report-form" data-loading-text="Preparing report...">
                            <div class="input-group input-group-lg">
                                <input type="text" name="chatInput" class="form-control"
                                       placeholder="Ask about assets, departments, locations, warranties, disposals, or values"
                                       value="@Model.LastReportQuestion"
                                       required>
                                <button class="btn btn-primary" type="submit">
                                    <span class="ready-label"><i class="bi bi-search me-1"></i>Prepare Report</span>
                                    <span class="loading-label d-none"><span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>Preparing...</span>
                                </button>
                            </div>

                            <div class="d-flex flex-wrap align-items-center gap-2 mt-3">
                                <span class="text-muted small">Try</span>
                                <button type="button" class="btn btn-sm btn-outline-secondary prompt-chip" data-prompt="assets under maintenance">Assets under maintenance</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary prompt-chip" data-prompt="warranty expiring this month">Warranty expiring this month</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary prompt-chip" data-prompt="high value items">High value items</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary prompt-chip" data-prompt="disposed assets">Disposed assets</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary prompt-chip" data-prompt="assets by department">Assets by department</button>
                            </div>

                            <div class="form-check form-switch mt-3">
                                <input class="form-check-input" type="checkbox" name="autoQuery" value="true" checked id="autoQuery">
                                <label class="form-check-label" for="autoQuery">
                                    Review generated report before showing results
                                </label>
                            </div>
                        </form>

                        @if (!string.IsNullOrEmpty(Model.GeneratedSql))
                        {
                            <div class="mt-3 border rounded">
                                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 p-3">
                                    <div>
                                        <div class="fw-semibold"><i class="bi bi-shield-check me-1 text-success"></i>Read-only report prepared</div>
                                        <small class="text-muted">Limited to report data. SQL is available for advanced review.</small>
                                    </div>
                                    <form method="post" asp-page-handler="RunSql" class="run-sql-form" data-loading-text="Showing results...">
                                        <input type="hidden" name="sqlQuery" value="@Model.GeneratedSql">
                                        <button type="submit" class="btn btn-success">
                                            <span class="ready-label"><i class="bi bi-play-circle me-1"></i>Show Results</span>
                                            <span class="loading-label d-none"><span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>Running...</span>
                                        </button>
                                    </form>
                                </div>
                                <div class="border-top">
                                    <button class="btn btn-link text-decoration-none w-100 text-start px-3 py-2"
                                            type="button"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#advancedSql"
                                            aria-expanded="false"
                                            aria-controls="advancedSql">
                                        <i class="bi bi-code-slash me-1"></i>Advanced: SQL preview
                                    </button>
                                    <div class="collapse" id="advancedSql">
                                        <div class="p-3 pt-0">
                                            <div class="d-flex justify-content-end mb-2">
                                                <button class="btn btn-sm btn-outline-secondary" type="button" onclick="copyToClipboard('sqlQuery')" title="Copy SQL">
                                                    <i class="bi bi-clipboard"></i>
                                                </button>
                                            </div>
                                            <pre class="mb-0" id="sqlQuery">@Model.GeneratedSql</pre>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        @{
                            var recentQuestions = Model.ChatHistory
                                .Where(message => message.Role == "user")
                                .Reverse()
                                .Take(3)
                                .ToList();
                        }
                        @if (recentQuestions.Any())
                        {
                            <div class="mt-3">
                                <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#recentQuestions" aria-expanded="false" aria-controls="recentQuestions">
                                    <i class="bi bi-clock-history me-1"></i>Recent questions
                                </button>
                                <div class="collapse mt-2" id="recentQuestions">
                                    <div class="d-flex flex-wrap gap-2">
                                        @foreach (var question in recentQuestions)
                                        {
                                            <button type="button" class="btn btn-sm btn-light border prompt-chip" data-prompt="@question.Content">@question.Content</button>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- Predefined Reports Section -->
        <div class="col-12">
            <div class="card mb-3">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-file-earmark-text me-2"></i>Predefined Reports</h5>
                    <span class="badge bg-light text-dark">6 Templates</span>
                </div>
                <div class="card-body">
                    <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-6 g-3">
                        <div class="col">
                            <a asp-page="/Reports/Index" asp-route-reportType="assets-by-status"
                               class="card h-100 report-card text-decoration-none @(Model.SelectedReportType == "assets-by-status" ? "border-primary border-2" : "")">
                                <div class="card-body text-center">
                                    <i class="bi bi-pie-chart-fill text-primary fs-1"></i>
                                    <h6 class="mt-2">Assets by Status</h6>
                                    <small class="text-muted">Distribution of assets by status</small>
                                    @if (Model.SelectedReportType == "assets-by-status")
                                    {
                                        <div class="mt-2">
                                            <span class="badge bg-primary">Selected</span>
                                        </div>
                                    }
                                </div>
                            </a>
                        </div>
                        <div class="col">
                            <a asp-page="/Reports/Index" asp-route-reportType="assets-by-department"
                               class="card h-100 report-card text-decoration-none @(Model.SelectedReportType == "assets-by-department" ? "border-primary border-2" : "")">
                                <div class="card-body text-center">
                                    <i class="bi bi-building text-success fs-1"></i>
                                    <h6 class="mt-2">Assets by Department</h6>
                                    <small class="text-muted">Department-wise asset allocation</small>
                                    @if (Model.SelectedReportType == "assets-by-department")
                                    {
                                        <div class="mt-2">
                                            <span class="badge bg-success">Selected</span>
                                        </div>
                                    }
                                </div>
                            </a>
                        </div>
                        <div class="col">
                            <a asp-page="/Reports/Index" asp-route-reportType="assets-by-location"
                               class="card h-100 report-card text-decoration-none @(Model.SelectedReportType == "assets-by-location" ? "border-primary border-2" : "")">
                                <div class="card-body text-center">
                                    <i class="bi bi-geo-alt text-warning fs-1"></i>
                                    <h6 class="mt-2">Assets by Location</h6>
                                    <small class="text-muted">Location-based asset distribution</small>
                                    @if (Model.SelectedReportType == "assets-by-location")
                                    {
                                        <div class="mt-2">
                                            <span class="badge bg-warning">Selected</span>
                                        </div>
                                    }
                                </div>
                            </a>
                        </div>
                        <div class="col">
                            <a asp-page="/Reports/Index" asp-route-reportType="maintenance-schedule"
                               class="card h-100 report-card text-decoration-none @(Model.SelectedReportType == "maintenance-schedule" ? "border-primary border-2" : "")">
                                <div class="card-body text-center">
                                    <i class="bi bi-tools text-danger fs-1"></i>
                                    <h6 class="mt-2">Maintenance Schedule</h6>
                                    <small class="text-muted">Upcoming maintenance tasks</small>
                                    @if (Model.SelectedReportType == "maintenance-schedule")
                                    {
                                        <div class="mt-2">
                                            <span class="badge bg-danger">Selected</span>
                                        </div>
                                    }
                                </div>
                            </a>
                        </div>
                        <div class="col">
                            <a asp-page="/Reports/Index" asp-route-reportType="warranty-expiry"
                               class="card h-100 report-card text-decoration-none @(Model.SelectedReportType == "warranty-expiry" ? "border-primary border-2" : "")">
                                <div class="card-body text-center">
                                    <i class="bi bi-calendar-check text-info fs-1"></i>
                                    <h6 class="mt-2">Warranty Expiry</h6>
                                    <small class="text-muted">Assets with expiring warranty</small>
                                    @if (Model.SelectedReportType == "warranty-expiry")
                                    {
                                        <div class="mt-2">
                                            <span class="badge bg-info">Selected</span>
                                        </div>
                                    }
                                </div>
                            </a>
                        </div>
                        <div class="col">
                            <a asp-page="/Reports/Index" asp-route-reportType="fixed-assets-schedule"
                               class="card h-100 report-card text-decoration-none @(Model.SelectedReportType == "fixed-assets-schedule" ? "border-primary border-2" : "")">
                                <div class="card-body text-center">
                                    <i class="bi bi-table text-primary fs-1"></i>
                                    <h6 class="mt-2">Fixed Assets Schedule</h6>
                                    <small class="text-muted">Category-based depreciation schedule with custom date range</small>
                                    @if (Model.SelectedReportType == "fixed-assets-schedule")
                                    {
                                        <div class="mt-2">
                                            <span class="badge bg-primary">Selected</span>
                                        </div>
                                    }
                                </div>
                            </a>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <!-- Report Results Section -->
    <div class="row mt-2">
        <div class="col-12">
            @if (Model.SelectedReportType == "fixed-assets-schedule")
            {
                <div class="card mb-3">
                    <div class="card-body">
                        <form method="get" class="row g-3 align-items-end">
                            <input type="hidden" name="reportType" value="fixed-assets-schedule" />
                            <div class="col-md-3">
                                <label for="startDate" class="form-label fw-bold">Start Date</label>
                                <input type="date" name="startDate" id="startDate" class="form-control"
                                       value="@(Model.StartDate?.ToString("yyyy-MM-dd") ?? new DateTime(DateTime.Now.Year, 1, 1).ToString("yyyy-MM-dd"))" />
                            </div>
                            <div class="col-md-3">
                                <label for="endDate" class="form-label fw-bold">End Date</label>
                                <input type="date" name="endDate" id="endDate" class="form-control"
                                       value="@(Model.EndDate?.ToString("yyyy-MM-dd") ?? new DateTime(DateTime.Now.Year, 12, 31).ToString("yyyy-MM-dd"))" />
                            </div>
                            <div class="col-md-3">
                                <button type="submit" class="btn btn-primary w-100">
                                    <i class="bi bi-search me-1"></i>Generate Report
                                </button>
                            </div>
                            <div class="col-md-3">
                                <div class="btn-group w-100" role="group">
                                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="setFixedAssetsDateRange('month')">This Month</button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="setFixedAssetsDateRange('quarter')">This Quarter</button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="setFixedAssetsDateRange('year')">This Year</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            }
            <div class="card">
                <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="bi bi-table me-2"></i>Report Results
                        <span class="badge bg-light text-dark ms-2">@Model.ReportResults.Count rows</span>
                    </h5>
                    <div>
                        @if (Model.ReportResults.Any())
                        {
                            <form method="post" asp-page-handler="ExportReport" class="d-inline me-2">
                                <input type="hidden" name="format" value="csv">
                                <input type="hidden" name="reportType" value="@Model.SelectedReportType">
                                @if (Model.SelectedReportType == "fixed-assets-schedule")
                                {
                                    <input type="hidden" name="startDate" value="@(Model.StartDate?.ToString("yyyy-MM-dd") ?? "")">
                                    <input type="hidden" name="endDate" value="@(Model.EndDate?.ToString("yyyy-MM-dd") ?? "")">
                                }
                                <button type="submit" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-file-earmark-text me-1"></i>Export to CSV
                                </button>
                            </form>
                            <form method="post" asp-page-handler="ExportReport" class="d-inline">
                                <input type="hidden" name="format" value="excel">
                                <input type="hidden" name="reportType" value="@Model.SelectedReportType">
                                @if (Model.SelectedReportType == "fixed-assets-schedule")
                                {
                                    <input type="hidden" name="startDate" value="@(Model.StartDate?.ToString("yyyy-MM-dd") ?? "")">
                                    <input type="hidden" name="endDate" value="@(Model.EndDate?.ToString("yyyy-MM-dd") ?? "")">
                                }
                                <button type="submit" class="btn btn-sm btn-success">
                                    <i class="bi bi-file-earmark-excel me-1"></i>Export to Excel
                                </button>
                            </form>
                        }
                    </div>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(Model.ResultSummary))
                    {
                        <div class="alert alert-light border d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                            <div>
                                <strong>@Model.ResultSummary</strong>
                                @if (!string.IsNullOrEmpty(Model.ResultSummaryMeta))
                                {
                                    <div class="small text-muted">@Model.ResultSummaryMeta</div>
                                }
                            </div>
                            @if (Model.IsAdmin && !string.IsNullOrEmpty(Model.GeneratedSql))
                            {
                                <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#advancedSql" aria-expanded="false" aria-controls="advancedSql">
                                    <i class="bi bi-code-slash me-1"></i>SQL
                                </button>
                            }
                        </div>
                    }
                    @if (Model.ReportResults.Any())
                    {
                        @if (Model.SelectedReportType == "fixed-assets-schedule")
                        {
                            <!-- Fixed Assets Schedule - Special formatting -->
                            <div class="table-responsive">
                                <table class="table table-bordered table-sm" id="reportTable" style="font-size: 0.9rem; width: auto; table-layout: auto;">
                                    <thead class="table-dark">
                                        <tr>
                                            @{
                                                var isFirstHeader = true;
                                            }
                                            @foreach (var key in Model.ReportResults.First().Keys)
                                            {
                                                <th class="text-center fw-bold" style="vertical-align: middle; white-space: nowrap; @(isFirstHeader ? "min-width: 180px;" : "")">
                                                    @if (key == "")
                                                    {
                                                        <span>&nbsp;</span>
                                                    }
                                                    else
                                                    {
                                                        @key
                                                    }
                                                </th>
                                                isFirstHeader = false;
                                            }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            var sectionHeaders = new[] { "Cost/Valuation", "Depreciation" };
                                            var currentSection = "";
                                        }
                                        @foreach (var row in Model.ReportResults)
                                        {
                                            var rowLabel = row.Values.FirstOrDefault()?.ToString() ?? "";
                                            
                                            @* Check if this is a section header row *@
                                            @if (rowLabel == "Cost/Valuation" || rowLabel == "Depreciation")
                                            {
                                                currentSection = rowLabel;
                                                <tr class="table-secondary">
                                                    <td colspan="@Model.ReportResults.First().Keys.Count" class="fw-bold py-2" style="font-size: 1rem;">
                                                        @rowLabel
                                                    </td>
                                                </tr>
                                            }
                                            else if (string.IsNullOrEmpty(rowLabel))
                                            {
                                                @* Empty separator row *@
                                                <tr style="height: 10px;">
                                                    <td colspan="@Model.ReportResults.First().Keys.Count" style="background-color: #f8f9fa;"></td>
                                                </tr>
                                            }
                                            else
                                            {
                                                <tr class="@(rowLabel.StartsWith("NBV") ? "table-info" : "")">
                                                    @{
                                                        var isFirst = true;
                                                        var columnIndex = 0;
                                                        var totalColumns = row.Values.Count();
                                                    }
                                                    @foreach (var value in row.Values)
                                                    {
                                                        @if (isFirst)
                                                        {
                                                            <td class="fw-bold" style="white-space: nowrap;">@value</td>
                                                            isFirst = false;
                                                        }
                                                        else if (columnIndex == totalColumns - 1)
                                                        {
                                                            @* Last column (Total) - make it bold *@
                                                            <td class="text-end fw-bold" style="white-space: nowrap; padding-left: 15px; padding-right: 15px;">
                                                                @if (value is decimal decimalValue)
                                                                {
                                                                    @decimalValue.ToString("N0")
                                                                }
                                                                else if (value?.ToString() == "-" || string.IsNullOrEmpty(value?.ToString()))
                                                                {
                                                                    <span class="text-muted">-</span>
                                                                }
                                                                else
                                                                {
                                                                    @value
                                                                }
                                                            </td>
                                                        }
                                                        else
                                                        {
                                                            <td class="text-end" style="white-space: nowrap; padding-left: 15px; padding-right: 15px;">
                                                                @if (value is decimal decimalValue)
                                                                {
                                                                    @decimalValue.ToString("N0")
                                                                }
                                                                else if (value?.ToString() == "-" || string.IsNullOrEmpty(value?.ToString()))
                                                                {
                                                                    <span class="text-muted">-</span>
                                                                }
                                                                else
                                                                {
                                                                    @value
                                                                }
                                                            </td>
                                                        }
                                                        columnIndex++;
                                                    }
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <!-- Standard table format for other reports -->
                            <div class="table-responsive">
                                <table class="table table-striped table-hover" id="reportTable">
                                    <thead class="table-dark">
                                        <tr>
                                            @foreach (var key in Model.ReportResults.First().Keys)
                                            {
                                                <th>@key</th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in Model.ReportResults)
                                        {
                                            <tr>
                                                @foreach (var value in row.Values)
                                                {
                                                    <td>
                                                        @if (value == null)
                                                        {
                                                            <span class="text-muted">&mdash;</span>
                                                        }
                                                        else if (value is DateTime dateValue)
                                                        {
                                                            @dateValue.ToString("dd MMM yyyy")
                                                        }
                                                        else if (value is decimal decimalValue)
                                                        {
                                                            @decimalValue.ToString("N2")
                                                        }
                                                        else if (value is int intValue)
                                                        {
                                                            @intValue.ToString("N0")
                                                        }
                                                        else if (value is long longValue)
                                                        {
                                                            @longValue.ToString("N0")
                                                        }
                                                        else
                                                        {
                                                            @value
                                                        }
                                                    </td>
                                                }
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center text-muted p-5">
                            <i class="bi bi-bar-chart fs-1"></i>
                            <p class="mt-3">Select a report template or ask a reporting question to see results.</p>
                            <div class="mt-3">
                                <small class="text-muted">Try: "assets under maintenance" or "warranty expiring this month"</small>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Function to scroll chat to bottom
        function scrollChatToBottom() {
            const chatContainer = document.getElementById('chatContainer');
            if (chatContainer) {
                chatContainer.scrollTop = chatContainer.scrollHeight;
            }
        }

        // Copy SQL to clipboard
        function copyToClipboard(elementId) {
            const element = document.getElementById(elementId);
            const text = element.textContent || element.innerText;

            navigator.clipboard.writeText(text).then(() => {
                // Show temporary success message
                const button = document.querySelector(`button[onclick="copyToClipboard('${elementId}')"]`);
                if (!button) {
                    return;
                }
                const originalHtml = button.innerHTML;
                button.innerHTML = '<i class="bi bi-check"></i>';
                button.classList.remove('btn-outline-secondary');
                button.classList.add('btn-success');

                setTimeout(() => {
                    button.innerHTML = originalHtml;
                    button.classList.remove('btn-success');
                    button.classList.add('btn-outline-secondary');
                }, 2000);
            });
        }



        // Initialize tooltips
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize Bootstrap tooltips
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });

            // Auto-focus report input
            const chatInput = document.querySelector('input[name="chatInput"]');
            if (chatInput) {
                chatInput.focus();
            }

            document.querySelectorAll('.prompt-chip').forEach(function(button) {
                button.addEventListener('click', function() {
                    const input = document.querySelector('input[name="chatInput"]');
                    if (!input) {
                        return;
                    }

                    input.value = button.dataset.prompt || button.textContent.trim();
                    input.focus();
                });
            });

            document.querySelectorAll('.ai-report-form, .run-sql-form').forEach(function(form) {
                form.addEventListener('submit', function() {
                    const submitButton = form.querySelector('button[type="submit"]');
                    if (!submitButton) {
                        return;
                    }

                    submitButton.querySelector('.ready-label')?.classList.add('d-none');
                    submitButton.querySelector('.loading-label')?.classList.remove('d-none');
                    submitButton.disabled = true;
                });
            });
        });

        // Auto-resize SQL query display
        function autoResizeTextarea(textarea) {
            textarea.style.height = 'auto';
            textarea.style.height = (textarea.scrollHeight) + 'px';
        }

        // Handle Enter key in chat input (but allow Shift+Enter for new line)
        document.querySelector('input[name="chatInput"]')?.addEventListener('keydown', function(e) {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                this.closest('form').querySelector('button[type="submit"]').click();
            }
        });

        // Date range helper functions for Fixed Assets Schedule
        function setFixedAssetsDateRange(period) {
            const today = new Date();
            const startDateInput = document.getElementById('startDate');
            const endDateInput = document.getElementById('endDate');
            
            let startDate = new Date();
            let endDate = new Date();
            
            switch(period) {
                case 'month':
                    // Start and end of current month
                    startDate = new Date(today.getFullYear(), today.getMonth(), 1);
                    endDate = new Date(today.getFullYear(), today.getMonth() + 1, 0);
                    break;
                case 'quarter':
                    // Start and end of current quarter
                    const quarter = Math.floor(today.getMonth() / 3);
                    startDate = new Date(today.getFullYear(), quarter * 3, 1);
                    endDate = new Date(today.getFullYear(), quarter * 3 + 3, 0);
                    break;
                case 'year':
                    // Start and end of current year
                    startDate = new Date(today.getFullYear(), 0, 1);
                    endDate = new Date(today.getFullYear(), 11, 31);
                    break;
            }
            
            startDateInput.value = startDate.toISOString().split('T')[0];
            endDateInput.value = endDate.toISOString().split('T')[0];
        }
    </script>
}

