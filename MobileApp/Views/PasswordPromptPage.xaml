<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Toolkit.TextInputLayout;assembly=Syncfusion.Maui.Toolkit"
             x:Class="MobileApp.Views.PasswordPromptPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource OverlayScrim}, Dark={StaticResource OverlayScrim}}">

    <Border VerticalOptions="Center"
            HorizontalOptions="Center"
            Margin="24"
            Padding="24"
            StrokeThickness="0"
            BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="16"/>
        </Border.StrokeShape>
        <VerticalStackLayout Spacing="16" WidthRequest="300">
            <Label x:Name="TitleLabel"
                   FontFamily="OpenSansSemibold"
                   FontSize="18"
                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
            <Label x:Name="MessageLabel"
                   FontSize="14"
                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
            <inputLayout:SfTextInputLayout
                ContainerType="Outlined"
                EnablePasswordVisibilityToggle="True"
                Hint="Password"
                OutlineCornerRadius="20">
                <Entry x:Name="PasswordEntry"
                       FontSize="14"
                       IsPassword="True"
                       ReturnType="Go"
                       Completed="OnConfirmClicked"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
            </inputLayout:SfTextInputLayout>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Grid.Column="0"
                        Text="Cancel"
                        Clicked="OnCancelClicked"
                        BackgroundColor="{StaticResource CancelGray}"
                        TextColor="White"
                        HeightRequest="44"
                        SemanticProperties.Hint="Cancel password entry"/>
                <Button Grid.Column="1"
                        Text="Continue"
                        Clicked="OnConfirmClicked"
                        BackgroundColor="{StaticResource AppBlue}"
                        TextColor="White"
                        HeightRequest="44"
                        SemanticProperties.Hint="Confirm password"/>
            </Grid>
        </VerticalStackLayout>
    </Border>
</ContentPage>
