<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MobileApp.ViewModels"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             x:Class="MobileApp.Views.AddLocationPage"
             x:DataType="viewmodels:AddLocationViewModel"
             Title="Add Location"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="56,*,Auto">
        
        <!-- Top Header Bar -->
        <Frame Grid.Row="0" 
               BackgroundColor="{StaticResource AppBlue}" 
               CornerRadius="0" 
               Padding="0"
               HasShadow="True">
            <Grid ColumnDefinitions="56,*,56" Padding="0">
                <!-- Back Button -->
                <Button Grid.Column="0"
                        ImageSource="{mi:Material Icon=ArrowBack, IconColor=White}"
                        BackgroundColor="Transparent"
                        Command="{Binding CancelCommand}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        MinimumWidthRequest="44"
                        MinimumHeightRequest="44"
                        SemanticProperties.Description="Go back"/>
                
                <!-- Title -->
                <Label Grid.Column="1"
                       Text="Add Location"
                       FontFamily="OpenSansSemibold"
                       FontSize="20"
                       TextColor="White"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
                
                <Button Grid.Column="2"
                        ImageSource="{mi:Material Icon=Save, IconColor=White}"
                        BackgroundColor="Transparent"
                        Command="{Binding SaveLocationCommand}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        MinimumWidthRequest="44"
                        MinimumHeightRequest="44"
                        SemanticProperties.Description="Save location"/>
            </Grid>
        </Frame>

        <!-- Form Content -->
        <ScrollView Grid.Row="1" Padding="16">
            <VerticalStackLayout Spacing="16">
                
                <!-- Location Name -->
                <Frame BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}" 
                       CornerRadius="12" 
                       Padding="16"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Location Name *"
                               FontFamily="OpenSansSemibold"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
                        <Entry Text="{Binding Name}"
                               Placeholder="e.g., Main Building"
                               PlaceholderColor="{AppThemeBinding Light={StaticResource TextTertiary}, Dark={StaticResource TextTertiaryDark}}"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                               FontSize="16"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Campus -->
                <Frame BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}" 
                       CornerRadius="12" 
                       Padding="16"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Campus *"
                               FontFamily="OpenSansSemibold"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
                        <Entry Text="{Binding Campus}"
                               Placeholder="e.g., Main Campus"
                               PlaceholderColor="{AppThemeBinding Light={StaticResource TextTertiary}, Dark={StaticResource TextTertiaryDark}}"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                               FontSize="16"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Building -->
                <Frame BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}" 
                       CornerRadius="12" 
                       Padding="16"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Building (Optional)"
                               FontFamily="OpenSansSemibold"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
                        <Entry Text="{Binding Building}"
                               Placeholder="e.g., Science Building"
                               PlaceholderColor="{AppThemeBinding Light={StaticResource TextTertiary}, Dark={StaticResource TextTertiaryDark}}"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                               FontSize="16"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Room -->
                <Frame BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}" 
                       CornerRadius="12" 
                       Padding="16"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Room (Optional)"
                               FontFamily="OpenSansSemibold"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
                        <Entry Text="{Binding Room}"
                               Placeholder="e.g., Room 101"
                               PlaceholderColor="{AppThemeBinding Light={StaticResource TextTertiary}, Dark={StaticResource TextTertiaryDark}}"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                               FontSize="16"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Description -->
                <Frame BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}" 
                       CornerRadius="12" 
                       Padding="16"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Description (Optional)"
                               FontFamily="OpenSansSemibold"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
                        <Editor Text="{Binding Description}"
                                Placeholder="Additional details about this location..."
                                PlaceholderColor="{AppThemeBinding Light={StaticResource TextTertiary}, Dark={StaticResource TextTertiaryDark}}"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                FontSize="16"
                                HeightRequest="100"
                                AutoSize="TextChanges"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- GPS Coordinates Section -->
                <Frame BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}" 
                       CornerRadius="12" 
                       Padding="16"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="GPS Coordinates (Optional)"
                               FontFamily="OpenSansSemibold"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
                        
                        <!-- Coordinates Display -->
                        <Frame BackgroundColor="{AppThemeBinding Light={StaticResource InputFill}, Dark={StaticResource InputFillDark}}"
                               CornerRadius="8"
                               Padding="12"
                               HasShadow="False">
                            <HorizontalStackLayout Spacing="8">
                                <Image WidthRequest="20" HeightRequest="20" VerticalOptions="Center">
                                    <Image.Source>
                                        <FontImageSource FontFamily="MaterialIcons-Regular"
                                                       Glyph="{mi:Material Icon=LocationOn}"
                                                       Color="{StaticResource AppBlue}"
                                                       Size="20"/>
                                    </Image.Source>
                                </Image>
                                <Label Text="{Binding CoordinatesDisplay}"
                                       FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                       VerticalOptions="Center"
                                       HorizontalOptions="FillAndExpand"/>
                            </HorizontalStackLayout>
                        </Frame>

                        <!-- Capture/Clear Buttons -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Button Grid.Column="0"
                                    Text="Capture"
                                    BackgroundColor="{StaticResource AppBlue}"
                                    TextColor="White"
                                    CornerRadius="8"
                                    Command="{Binding CaptureLocationCommand}"
                                    IsEnabled="{Binding IsCapturingLocation, Converter={StaticResource InvertedBoolConverter}}"/>
                            
                            <Button Grid.Column="1"
                                    Text="Clear"
                                    BackgroundColor="{StaticResource DangerRed}"
                                    TextColor="White"
                                    CornerRadius="8"
                                    Command="{Binding ClearCoordinatesCommand}"
                                    IsVisible="{Binding HasCoordinates}"/>
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- Required Fields Note -->
                <Label Text="* Required fields"
                       FontSize="12"
                       TextColor="{AppThemeBinding Light={StaticResource TextTertiary}, Dark={StaticResource TextTertiaryDark}}"
                       HorizontalOptions="Start"
                       Margin="4,0,0,0"/>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom Action Buttons -->
        <Grid Grid.Row="2" 
              ColumnDefinitions="*,*" 
              ColumnSpacing="12"
              Padding="16"
              BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}">
            <Border Grid.Column="0"
                    StrokeThickness="0">
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.1" Radius="8" Offset="0,-2"/>
                </Border.Shadow>
            </Border>
            
            <Button Grid.Column="0"
                    Text="Cancel"
                    BackgroundColor="{StaticResource CancelGray}"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="50"
                    FontFamily="OpenSansSemibold"
                    Command="{Binding CancelCommand}"/>
            
            <Button Grid.Column="1"
                    Text="Save Location"
                    BackgroundColor="{StaticResource AppBlue}"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="50"
                    FontFamily="OpenSansSemibold"
                    Command="{Binding SaveLocationCommand}"/>
        </Grid>

        <!-- Location Capture Overlay -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              BackgroundColor="{StaticResource OverlayScrim}"
              IsVisible="{Binding IsCapturingLocation}">
            <VerticalStackLayout HorizontalOptions="Center"
                                VerticalOptions="Center"
                                Spacing="16">
                <ActivityIndicator IsRunning="True"
                                 Color="White"
                                 WidthRequest="48"
                                 HeightRequest="48"/>
                <Label Text="Capturing GPS location..."
                       FontFamily="OpenSansSemibold"
                       FontSize="16"
                       TextColor="White"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Grid>

        <!-- Busy Overlay -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              BackgroundColor="{StaticResource OverlayScrim}"
              IsVisible="{Binding IsBusy}">
            <VerticalStackLayout HorizontalOptions="Center"
                                VerticalOptions="Center"
                                Spacing="16">
                <ActivityIndicator IsRunning="True"
                                 Color="White"
                                 WidthRequest="48"
                                 HeightRequest="48"/>
                <Label Text="Saving location..."
                       FontFamily="OpenSansSemibold"
                       FontSize="16"
                       TextColor="White"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Grid>

    </Grid>
</ContentPage>