<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MobileApp.ViewModels"
             xmlns:controls="clr-namespace:MobileApp.Controls"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:mci="clr-namespace:MauiIcons.Core;assembly=MauiIcons.Core"
             x:Class="MobileApp.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="Settings"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <Grid RowDefinitions="Auto,*">
        
        <!-- Header Section -->
        <Grid Grid.Row="0"
              BackgroundColor="{StaticResource AppBlue}"
              Padding="20,15,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Back Button -->
            <Border Grid.Column="0"
                    BackgroundColor="Transparent"
                    Stroke="Transparent"
                    Padding="8"
                    MinimumWidthRequest="44"
                    MinimumHeightRequest="44"
                    VerticalOptions="Center"
                    HorizontalOptions="Start"
                    SemanticProperties.Description="Go back">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <Image WidthRequest="24" HeightRequest="24"
                       HorizontalOptions="Center"
                       VerticalOptions="Center">
                    <Image.Source>
                        <FontImageSource FontFamily="MaterialIcons-Regular"
                                       Glyph="{mi:Material Icon=ArrowBack}"
                                       Color="White"
                                       Size="24"/>
                    </Image.Source>
                </Image>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                </Border.GestureRecognizers>
            </Border>
            
            <!-- Title -->
            <Label Grid.Column="1"
                   Text="Settings"
                   FontFamily="OpenSansRegular"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="White"
                   VerticalOptions="Center"
                   Margin="12,0,0,0"/>
        </Grid>

        <!-- Settings Content -->
        <ScrollView Grid.Row="1">
            <Grid>
                <!-- Skeleton Loaders (visible while loading) -->
                <VerticalStackLayout Spacing="24" Padding="20,20,20,20" IsVisible="{Binding IsBusy}">
                    <VerticalStackLayout Spacing="12">
                        <BoxView BackgroundColor="{AppThemeBinding Light={StaticResource ChipInactive}, Dark={StaticResource ChipInactiveDark}}" HeightRequest="18" WidthRequest="80" CornerRadius="4"/>
                        <controls:SkeletonLoader Type="Card"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="12">
                        <BoxView BackgroundColor="{AppThemeBinding Light={StaticResource ChipInactive}, Dark={StaticResource ChipInactiveDark}}" HeightRequest="18" WidthRequest="120" CornerRadius="4"/>
                        <controls:SkeletonLoader Type="Card"/>
                        <controls:SkeletonLoader Type="Card"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="12">
                        <BoxView BackgroundColor="{AppThemeBinding Light={StaticResource ChipInactive}, Dark={StaticResource ChipInactiveDark}}" HeightRequest="18" WidthRequest="70" CornerRadius="4"/>
                        <controls:SkeletonLoader Type="Card"/>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Actual Content (visible when loaded) -->
                <VerticalStackLayout Spacing="24" Padding="20,20,20,20" IsVisible="{Binding IsNotBusy}">
                
                <!-- Security Section -->
                <VerticalStackLayout Spacing="12" IsVisible="{Binding BiometricAvailable}">
                    <Label Text="Security"
                           FontFamily="OpenSansSemibold"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                           Margin="4,0,0,0"/>
                    
                    <!-- Biometric Login Toggle -->
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                            Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}"
                            StrokeThickness="1"
                            Padding="16"
                            MinimumHeightRequest="72">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="Black" Opacity="0.04" Radius="6" Offset="0,1"/>
                        </Border.Shadow>
                        <Grid ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="14"
                              VerticalOptions="Center">
                            <Border Grid.Column="0"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource IconBackgroundBlue}, Dark={StaticResource IconBackgroundBlueDark}}"
                                    WidthRequest="44"
                                    HeightRequest="44"
                                    Stroke="Transparent"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="22"/>
                                </Border.StrokeShape>
                                <Image WidthRequest="24"
                                       HeightRequest="24"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       mci:MauiIcon.Value="{mi:Material Icon=Fingerprint, IconColor={StaticResource AppBlue}}"/>
                            </Border>
                            
                            <VerticalStackLayout Grid.Column="1"
                                               VerticalOptions="Center"
                                               Spacing="2">
                                <Label Text="Biometric login"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="16"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource TextPrimaryDark}}"/>
                                <Label Text="{Binding BiometricStatusText}"
                                       FontFamily="OpenSansRegular"
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                       LineBreakMode="TailTruncation"/>
                            </VerticalStackLayout>
                            
                            <!-- Rounded track so off-state is visible without a rectangular Switch BackgroundColor -->
                            <Border Grid.Column="2"
                                    BackgroundColor="{Binding BiometricEnabled, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#005A9C|#BDBDBD'}"
                                    Stroke="Transparent"
                                    WidthRequest="52"
                                    HeightRequest="32"
                                    VerticalOptions="Center"
                                    HorizontalOptions="End"
                                    Padding="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16"/>
                                </Border.StrokeShape>
                                <Switch IsToggled="{Binding BiometricEnabled}"
                                        OnColor="{StaticResource AppBlue}"
                                        ThumbColor="White"
                                        BackgroundColor="Transparent"
                                        VerticalOptions="Center"
                                        HorizontalOptions="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                </VerticalStackLayout>
                
                <!-- Data Management Section -->
                <VerticalStackLayout Spacing="12">
                    <Label Text="Data Management"
                           FontFamily="OpenSansRegular"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                           Margin="0,0,0,4"/>
                    
                    <!-- Clear Local Data Button -->
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                            Stroke="Transparent"
                            Padding="20,18"
                            Shadow="{Shadow Brush=Black, Opacity=0.06, Radius=8, Offset='0,2'}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                            <Border Grid.Column="0"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource IconBackgroundRed}, Dark={StaticResource ErrorBackgroundDark}}"
                                    WidthRequest="48"
                                    HeightRequest="48"
                                    Stroke="Transparent">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="24"/>
                                </Border.StrokeShape>
                                <Image WidthRequest="24" HeightRequest="24"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center">
                                    <Image.Source>
                                        <FontImageSource FontFamily="MaterialIcons-Regular"
                                                       Glyph="{mi:Material Icon=Delete}"
                                                       Color="{StaticResource DangerRed}"
                                                       Size="24"/>
                                    </Image.Source>
                                </Image>
                            </Border>
                            
                            <VerticalStackLayout Grid.Column="1"
                                               VerticalOptions="Center"
                                               Spacing="2">
                                <Label Text="Clear Local Data"
                                       FontFamily="OpenSansRegular"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
                                <Label Text="Delete all locally stored assets and sync queue"
                                       FontFamily="OpenSansRegular"
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                            </VerticalStackLayout>
                            
                            <Image Grid.Column="2"
                                   WidthRequest="24"
                                   HeightRequest="24"
                                   VerticalOptions="Center">
                                <Image.Source>
                                    <FontImageSource FontFamily="MaterialIcons-Regular"
                                                   Glyph="{mi:Material Icon=ChevronRight}"
                                                   Color="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource Gray500}}"
                                                   Size="24"/>
                                </Image.Source>
                            </Image>
                        </Grid>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ClearLocalDataCommand}"/>
                        </Border.GestureRecognizers>
                    </Border>
                    
                    <!-- Reset Sync State Button -->
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                            Stroke="Transparent"
                            Padding="20,18"
                            Shadow="{Shadow Brush=Black, Opacity=0.06, Radius=8, Offset='0,2'}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                            <Border Grid.Column="0"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource IconBackgroundOrange}, Dark={StaticResource IconBackgroundOrangeDark}}"
                                    WidthRequest="48"
                                    HeightRequest="48"
                                    Stroke="Transparent">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="24"/>
                                </Border.StrokeShape>
                                <Image WidthRequest="24" HeightRequest="24"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center">
                                    <Image.Source>
                                        <FontImageSource FontFamily="MaterialIcons-Regular"
                                                       Glyph="{mi:Material Icon=Sync}"
                                                       Color="{StaticResource SyncOrange}"
                                                       Size="24"/>
                                    </Image.Source>
                                </Image>
                            </Border>
                            
                            <VerticalStackLayout Grid.Column="1"
                                               VerticalOptions="Center"
                                               Spacing="2">
                                <Label Text="Reset Sync State"
                                       FontFamily="OpenSansRegular"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
                                <Label Text="Force full re-sync from server on next pull"
                                       FontFamily="OpenSansRegular"
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                            </VerticalStackLayout>
                            
                            <Image Grid.Column="2"
                                   WidthRequest="24"
                                   HeightRequest="24"
                                   VerticalOptions="Center">
                                <Image.Source>
                                    <FontImageSource FontFamily="MaterialIcons-Regular"
                                                   Glyph="{mi:Material Icon=ChevronRight}"
                                                   Color="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource Gray500}}"
                                                   Size="24"/>
                                </Image.Source>
                            </Image>
                        </Grid>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ResetSyncStateCommand}"/>
                        </Border.GestureRecognizers>
                    </Border>
                </VerticalStackLayout>
                
                <!-- Account Section -->
                <VerticalStackLayout Spacing="12">
                    <Label Text="Account"
                           FontFamily="OpenSansRegular"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                           Margin="0,0,0,4"/>
                    
                    <!-- Logout Button -->
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                            Stroke="Transparent"
                            Padding="20,18"
                            Shadow="{Shadow Brush=Black, Opacity=0.06, Radius=8, Offset='0,2'}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                            <Border Grid.Column="0"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource IconBackgroundIndigo}, Dark={StaticResource IconBackgroundIndigoDark}}"
                                    WidthRequest="48"
                                    HeightRequest="48"
                                    Stroke="Transparent">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="24"/>
                                </Border.StrokeShape>
                                <Image WidthRequest="24" HeightRequest="24"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center">
                                    <Image.Source>
                                        <FontImageSource FontFamily="MaterialIcons-Regular"
                                                       Glyph="{mi:Material Icon=Logout}"
                                                       Color="{StaticResource AppBlue}"
                                                       Size="24"/>
                                    </Image.Source>
                                </Image>
                            </Border>
                            
                            <VerticalStackLayout Grid.Column="1"
                                               VerticalOptions="Center"
                                               Spacing="2">
                                <Label Text="Logout"
                                       FontFamily="OpenSansRegular"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
                                <Label Text="Sign out of your account"
                                       FontFamily="OpenSansRegular"
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                            </VerticalStackLayout>
                            
                            <Image Grid.Column="2"
                                   WidthRequest="24"
                                   HeightRequest="24"
                                   VerticalOptions="Center">
                                <Image.Source>
                                    <FontImageSource FontFamily="MaterialIcons-Regular"
                                                   Glyph="{mi:Material Icon=ChevronRight}"
                                                   Color="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource Gray500}}"
                                                   Size="24"/>
                                </Image.Source>
                            </Image>
                        </Grid>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding LogoutCommand}"/>
                        </Border.GestureRecognizers>
                    </Border>
                </VerticalStackLayout>
                
                <!-- App Info Section -->
                <VerticalStackLayout Spacing="12">
                    <Label Text="About"
                           FontFamily="OpenSansRegular"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                           Margin="0,0,0,4"/>

                    <!-- Beta updates toggle -->
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                            Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}"
                            StrokeThickness="1"
                            Padding="16"
                            MinimumHeightRequest="72">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="Black" Opacity="0.04" Radius="6" Offset="0,1"/>
                        </Border.Shadow>
                        <Grid ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="14"
                              VerticalOptions="Center">
                            <Border Grid.Column="0"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource IconBackgroundAmber}, Dark={StaticResource IconBackgroundAmberDark}}"
                                    WidthRequest="44"
                                    HeightRequest="44"
                                    Stroke="Transparent"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="22"/>
                                </Border.StrokeShape>
                                <Image WidthRequest="24"
                                       HeightRequest="24"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       mci:MauiIcon.Value="{mi:Material Icon=Science, IconColor=#F9A825}"/>
                            </Border>

                            <VerticalStackLayout Grid.Column="1"
                                               VerticalOptions="Center"
                                               Spacing="2">
                                <Label Text="Beta updates"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="16"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource TextPrimaryDark}}"/>
                                <Label Text="{Binding BetaUpdatesStatusText}"
                                       FontFamily="OpenSansRegular"
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                       LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>

                            <Border Grid.Column="2"
                                    BackgroundColor="{Binding BetaUpdatesEnabled, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#005A9C|#BDBDBD'}"
                                    Stroke="Transparent"
                                    WidthRequest="52"
                                    HeightRequest="32"
                                    VerticalOptions="Center"
                                    HorizontalOptions="End"
                                    Padding="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16"/>
                                </Border.StrokeShape>
                                <Switch IsToggled="{Binding BetaUpdatesEnabled}"
                                        OnColor="{StaticResource AppBlue}"
                                        ThumbColor="White"
                                        BackgroundColor="Transparent"
                                        VerticalOptions="Center"
                                        HorizontalOptions="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                    
                    <!-- Check for Updates Button -->
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                            Stroke="Transparent"
                            Padding="20,18"
                            Shadow="{Shadow Brush=Black, Opacity=0.06, Radius=8, Offset='0,2'}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                            <Border Grid.Column="0"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource IconBackgroundBlue}, Dark={StaticResource IconBackgroundBlueDark}}"
                                    WidthRequest="48"
                                    HeightRequest="48"
                                    Stroke="Transparent">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="24"/>
                                </Border.StrokeShape>
                                <Image WidthRequest="24" HeightRequest="24"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center">
                                    <Image.Source>
                                        <FontImageSource FontFamily="MaterialIcons-Regular"
                                                       Glyph="{mi:Material Icon=SystemUpdate}"
                                                       Color="{StaticResource AppBlue}"
                                                       Size="24"/>
                                    </Image.Source>
                                </Image>
                            </Border>
                            
                            <VerticalStackLayout Grid.Column="1"
                                               VerticalOptions="Center"
                                               Spacing="2">
                                <Label Text="Check for Updates"
                                       FontFamily="OpenSansRegular"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
                                <Label Text="{Binding AppVersion}"
                                       FontFamily="OpenSansRegular"
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                            </VerticalStackLayout>
                            
                            <Image Grid.Column="2"
                                   WidthRequest="24"
                                   HeightRequest="24"
                                   VerticalOptions="Center">
                                <Image.Source>
                                    <FontImageSource FontFamily="MaterialIcons-Regular"
                                                   Glyph="{mi:Material Icon=ChevronRight}"
                                                   Color="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource Gray500}}"
                                                   Size="24"/>
                                </Image.Source>
                            </Image>
                        </Grid>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CheckForUpdatesCommand}"/>
                        </Border.GestureRecognizers>
                    </Border>
                    
                    <!-- App Info -->
                    <VerticalStackLayout Spacing="8" Margin="0,12,0,0">
                        <Label Text="Asset Management Mobile"
                               FontFamily="OpenSansRegular"
                               FontSize="14"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                        <Label Text="{Binding AppVersion}"
                               FontFamily="OpenSansRegular"
                               FontSize="12"
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource TextTertiary}, Dark={StaticResource TextTertiaryDark}}"/>
                    </VerticalStackLayout>
                </VerticalStackLayout>
                
                </VerticalStackLayout>
            </Grid>
        </ScrollView>

    </Grid>

</ContentPage>