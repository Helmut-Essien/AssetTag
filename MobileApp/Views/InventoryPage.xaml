<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MobileApp.ViewModels"
             xmlns:controls="clr-namespace:MobileApp.Controls"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:mci="clr-namespace:MauiIcons.Core;assembly=MauiIcons.Core"
             x:Class="MobileApp.Views.InventoryPage"
             x:Name="RootPage"
             x:DataType="viewmodels:InventoryViewModel"
             Title="Inventory"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="56,Auto,*">
        
        <Border Grid.Row="0"
                BackgroundColor="{StaticResource AppBlue}"
                StrokeThickness="0"
                Padding="0">
            <Grid ColumnDefinitions="16,*,56" Padding="0">
                <Label Grid.Column="1"
                       Text="Inventory"
                       FontFamily="OpenSansSemibold"
                       FontSize="20"
                       TextColor="White"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
                
                <Button Grid.Column="2"
                        ImageSource="{mi:Material Icon=Sort, IconColor=White}"
                        BackgroundColor="Transparent"
                        Command="{Binding ShowSortOptionsCommand}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        MinimumWidthRequest="44"
                        MinimumHeightRequest="44"
                        SemanticProperties.Description="Sort inventory"/>
            </Grid>
        </Border>

        <VerticalStackLayout Grid.Row="1" Padding="16,12" Spacing="12">
            
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                    StrokeThickness="0"
                    Padding="12,8">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24"/>
                </Border.StrokeShape>
                <Grid ColumnDefinitions="24,*,44,44">
                    <Image Grid.Column="0"
                           WidthRequest="20"
                           HeightRequest="20"
                           VerticalOptions="Center">
                        <Image.Source>
                            <FontImageSource FontFamily="MaterialIcons-Regular"
                                           Glyph="{mi:Material Icon=Search}"
                                           Color="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                           Size="20"/>
                        </Image.Source>
                    </Image>
                    
                    <Entry Grid.Column="1"
                           Placeholder="Search by name, tag, or serial..."
                           PlaceholderColor="{AppThemeBinding Light={StaticResource TextTertiary}, Dark={StaticResource TextTertiaryDark}}"
                           Text="{Binding SearchText}"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                           FontSize="14"
                           VerticalOptions="Center"
                           Margin="8,0"/>
                    
                    <Button Grid.Column="2"
                            ImageSource="{mi:Material Icon=QrCodeScanner, IconColor={StaticResource AppBlue}}"
                            BackgroundColor="Transparent"
                            Command="{Binding ScanToSearchCommand}"
                            VerticalOptions="Center"
                            MinimumWidthRequest="44"
                            MinimumHeightRequest="44"
                            Padding="0"
                            SemanticProperties.Description="Scan barcode to search"/>
                    
                    <Button Grid.Column="3"
                            ImageSource="{mi:Material Icon=Close, IconColor={StaticResource TextSecondary}}"
                            BackgroundColor="Transparent"
                            Command="{Binding ClearSearchCommand}"
                            IsVisible="{Binding SearchText, Converter={StaticResource StringToBoolConverter}}"
                            VerticalOptions="Center"
                            MinimumWidthRequest="44"
                            MinimumHeightRequest="44"
                            Padding="0"
                            SemanticProperties.Description="Clear search"/>
                </Grid>
            </Border>

            <ScrollView Orientation="Horizontal"
                        HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="8">
                    <Border Padding="12,8"
                            StrokeThickness="0"
                            MinimumHeightRequest="44"
                            BackgroundColor="{AppThemeBinding Light={StaticResource ChipInactive}, Dark={StaticResource ChipInactiveDark}}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsAllFilterActive}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource AppBlue}"/>
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleAllFilterCommand}"/>
                        </Border.GestureRecognizers>
                        <Label Text="All"
                               FontFamily="OpenSansSemibold"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                               VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsAllFilterActive}" Value="True">
                                    <Setter Property="TextColor" Value="White"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>

                    <Border Padding="12,8"
                            StrokeThickness="0"
                            MinimumHeightRequest="44"
                            BackgroundColor="{AppThemeBinding Light={StaticResource ChipInactive}, Dark={StaticResource ChipInactiveDark}}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ShowAdvancedFiltersCommand}"/>
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="4">
                            <Image WidthRequest="16" HeightRequest="16" VerticalOptions="Center">
                                <Image.Source>
                                    <FontImageSource FontFamily="MaterialIcons-Regular"
                                                   Glyph="{mi:Material Icon=FilterList}"
                                                   Color="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                   Size="16"/>
                                </Image.Source>
                            </Image>
                            <Label Text="{Binding FilterChipLabel}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>

                    <Border Padding="12,8"
                            StrokeThickness="0"
                            MinimumHeightRequest="44"
                            BackgroundColor="{AppThemeBinding Light={StaticResource ChipInactive}, Dark={StaticResource ChipInactiveDark}}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsPendingSyncFilterActive}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource AppBlue}"/>
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding TogglePendingSyncFilterCommand}"/>
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="4">
                            <Image WidthRequest="16" HeightRequest="16" VerticalOptions="Center"
                                   IsVisible="{Binding IsPendingSyncFilterActive, Converter={StaticResource InvertedBoolConverter}}">
                                <Image.Source>
                                    <FontImageSource FontFamily="MaterialIcons-Regular"
                                                   Glyph="{mi:Material Icon=SyncProblem}"
                                                   Color="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                   Size="16"/>
                                </Image.Source>
                            </Image>
                            <Image WidthRequest="16" HeightRequest="16" VerticalOptions="Center"
                                   IsVisible="{Binding IsPendingSyncFilterActive}">
                                <Image.Source>
                                    <FontImageSource FontFamily="MaterialIcons-Regular"
                                                   Glyph="{mi:Material Icon=SyncProblem}"
                                                   Color="White"
                                                   Size="16"/>
                                </Image.Source>
                            </Image>
                            <Label Text="Pending Sync"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                   VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsPendingSyncFilterActive}" Value="True">
                                        <Setter Property="TextColor" Value="White"/>
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </HorizontalStackLayout>
                    </Border>
                </HorizontalStackLayout>
            </ScrollView>
        </VerticalStackLayout>

        <Grid Grid.Row="2">
            
            <ScrollView x:Name="SkeletonView"
                        Margin="16,0"
                        IsVisible="{Binding IsBusy}">
                <controls:SkeletonListView Type="AssetItem" Count="8" ItemSpacing="0"/>
            </ScrollView>
            
            <RefreshView x:Name="AssetListView"
                         x:DataType="viewmodels:InventoryViewModel"
                         IsRefreshing="{Binding IsRefreshing}"
                         Command="{Binding RefreshCommand}"
                         RefreshColor="{StaticResource AppBlue}"
                         IsVisible="{Binding HasAssets}">
                <CollectionView x:DataType="viewmodels:InventoryViewModel"
                                ItemsSource="{Binding Assets}"
                                SelectionMode="None"
                                Margin="16,0"
                                ItemsUpdatingScrollMode="KeepScrollOffset"
                                RemainingItemsThreshold="5"
                                RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:AssetItemViewModel">
                            <Border Margin="0,8"
                                    Padding="0"
                                    StrokeThickness="0"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding TapCommand}"/>
                                </Border.GestureRecognizers>
                                
                                <Grid ColumnDefinitions="4,56,*,24"
                                      HeightRequest="80">
                                    
                                    <BoxView Grid.Column="0"
                                             BackgroundColor="{Binding SyncStatusColor}"
                                             Color="{Binding SyncStatusColor}"/>
                                    
                                    <Border Grid.Column="1"
                                            WidthRequest="40"
                                            HeightRequest="40"
                                            StrokeThickness="0"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource IconBackgroundBlue}, Dark={StaticResource IconBackgroundBlueDark}}"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center"
                                            Margin="8,0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="20"/>
                                        </Border.StrokeShape>
                                        <Image WidthRequest="24"
                                               HeightRequest="24"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               mci:MauiIcon.Value="{mi:Material Icon={Binding CategoryIcon}, IconColor={StaticResource AppBlue}}"/>
                                    </Border>
                                    
                                    <VerticalStackLayout Grid.Column="2"
                                                         Padding="12,16"
                                                         Spacing="4"
                                                         VerticalOptions="Center">
                                        <Label Text="{Binding Name}"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="16"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1"/>
                                        
                                        <HorizontalStackLayout Spacing="8">
                                            <Label Text="{Binding DisplayTag}"
                                                   FontSize="14"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                   LineBreakMode="TailTruncation"/>
                                            <Label Text="•"
                                                   FontSize="14"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                            <Label Text="{Binding DisplayLocation}"
                                                   FontSize="14"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                   LineBreakMode="TailTruncation"/>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                    
                                    <Image Grid.Column="3"
                                           WidthRequest="24"
                                           HeightRequest="24"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           Margin="0,0,8,0">
                                        <Image.Source>
                                            <FontImageSource FontFamily="MaterialIcons-Regular"
                                                           Glyph="{mi:Material Icon=ChevronRight}"
                                                           Color="{AppThemeBinding Light={StaticResource TextTertiary}, Dark={StaticResource TextTertiaryDark}}"
                                                           Size="24"/>
                                        </Image.Source>
                                    </Image>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    
                    <CollectionView.Footer>
                        <Grid Padding="16,12"
                              IsVisible="{Binding IsLoadingMore}"
                              HeightRequest="60">
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                                    Padding="16,12"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8">
                                <HorizontalStackLayout HorizontalOptions="Center"
                                                      VerticalOptions="Center"
                                                      Spacing="12">
                                    <ActivityIndicator IsRunning="True"
                                                     Color="{StaticResource AppBlue}"
                                                     WidthRequest="20"
                                                     HeightRequest="20"
                                                     VerticalOptions="Center"/>
                                    <Label Text="Loading more assets..."
                                           FontFamily="OpenSansRegular"
                                           FontSize="14"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                           VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>
                    </CollectionView.Footer>
                    
                </CollectionView>
            </RefreshView>

            <VerticalStackLayout x:Name="EmptyStateView"
                                 IsVisible="{Binding ShowEmptyState}"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Spacing="16"
                                 Padding="32">
                <Image WidthRequest="64" HeightRequest="64" HorizontalOptions="Center">
                    <Image.Source>
                        <FontImageSource FontFamily="MaterialIcons-Regular"
                                       Glyph="{mi:Material Icon=Inventory2}"
                                       Color="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource Gray500}}"
                                       Size="64"/>
                    </Image.Source>
                </Image>
                
                <Label Text="No Assets Found"
                       FontFamily="OpenSansSemibold"
                       FontSize="18"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                       HorizontalOptions="Center"/>
                
                <Label Text="{Binding EmptyStateMessage}"
                       FontSize="14"
                       TextColor="{AppThemeBinding Light={StaticResource TextTertiary}, Dark={StaticResource TextTertiaryDark}}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>

        </Grid>

        <Button Grid.Row="2"
                ImageSource="{mi:Material Icon=Add, IconColor=White}"
                BackgroundColor="{StaticResource AppBlue}"
                CornerRadius="28"
                WidthRequest="56"
                HeightRequest="56"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="16"
                Command="{Binding AddAssetCommand}"
                Shadow="{StaticResource FABShadow}"
                SemanticProperties.Description="Add new asset"/>

        <!-- Category / location filter picker -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              IsVisible="{Binding IsFilterPickerOpen}"
              BackgroundColor="{StaticResource OverlayScrim}">
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                    StrokeThickness="0"
                    Margin="16,64,16,16"
                    Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>
                <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Text="{Binding FilterPickerTitle}"
                               FontFamily="OpenSansSemibold"
                               FontSize="18"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                               VerticalOptions="Center"/>
                        <Button Grid.Column="1"
                                ImageSource="{mi:Material Icon=Close, IconColor={StaticResource TextSecondary}}"
                                BackgroundColor="Transparent"
                                Command="{Binding CloseFilterPickerCommand}"
                                MinimumWidthRequest="44"
                                MinimumHeightRequest="44"
                                SemanticProperties.Description="Close filter picker"/>
                    </Grid>

                    <SearchBar Grid.Row="1"
                               Placeholder="{Binding FilterPickerSearchPlaceholder}"
                               Text="{Binding FilterPickerSearchText}"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                               PlaceholderColor="{AppThemeBinding Light={StaticResource TextTertiary}, Dark={StaticResource TextTertiaryDark}}"
                               CancelButtonColor="{StaticResource AppBlue}"
                               FontSize="14"/>

                    <CollectionView Grid.Row="2"
                                    ItemsSource="{Binding FilteredFilterPickerItems}"
                                    SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:FilterOption">
                                <Border Padding="12"
                                        Margin="0,0,0,8"
                                        Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}"
                                        StrokeThickness="1"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10"/>
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="FilterOption_Tapped"/>
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding Title}"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="15"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
                                        <Label Text="{Binding Subtitle}"
                                               IsVisible="{Binding HasSubtitle}"
                                               FontSize="13"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                               LineBreakMode="TailTruncation"/>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Label Grid.Row="2"
                           Text="No matching results."
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           InputTransparent="True"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding HasFilteredFilterOptions}" Value="True">
                                <Setter Property="IsVisible" Value="False"/>
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>

                    <Button Grid.Row="3"
                            Text="Close"
                            Command="{Binding CloseFilterPickerCommand}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource InputFill}, Dark={StaticResource InputFillDark}}"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                            HeightRequest="44"/>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
