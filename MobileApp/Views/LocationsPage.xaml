<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MobileApp.ViewModels"
             xmlns:controls="clr-namespace:MobileApp.Controls"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:mci="clr-namespace:MauiIcons.Core;assembly=MauiIcons.Core"
             x:Class="MobileApp.Views.LocationsPage"
             x:Name="RootPage"
             x:DataType="viewmodels:LocationsViewModel"
             Title="Locations"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="56,Auto,*">
        
        <Border Grid.Row="0"
                BackgroundColor="{StaticResource AppBlue}"
                StrokeThickness="0"
                Padding="0">
            <Grid ColumnDefinitions="16,*,56" Padding="0">
                <Label Grid.Column="1"
                       Text="Locations"
                       FontFamily="OpenSansSemibold"
                       FontSize="20"
                       TextColor="White"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
                
                <Button Grid.Column="2"
                        ImageSource="{mi:Material Icon=Sort, IconColor=White}"
                        BackgroundColor="Transparent"
                        Command="{Binding ShowSortOptionsCommand}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        MinimumWidthRequest="44"
                        MinimumHeightRequest="44"
                        SemanticProperties.Description="Sort locations"/>
            </Grid>
        </Border>

        <VerticalStackLayout Grid.Row="1" Padding="16,12" Spacing="12">
            
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                    StrokeThickness="0"
                    Padding="12,8">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24"/>
                </Border.StrokeShape>
                <Grid ColumnDefinitions="24,*,44">
                    <Image Grid.Column="0"
                           WidthRequest="20"
                           HeightRequest="20"
                           VerticalOptions="Center">
                        <Image.Source>
                            <FontImageSource FontFamily="MaterialIcons-Regular"
                                           Glyph="{mi:Material Icon=Search}"
                                           Color="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                           Size="20"/>
                        </Image.Source>
                    </Image>
                    
                    <Entry Grid.Column="1"
                           Placeholder="Search by name, campus, building..."
                           PlaceholderColor="{AppThemeBinding Light={StaticResource TextTertiary}, Dark={StaticResource TextTertiaryDark}}"
                           Text="{Binding SearchText}"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                           FontSize="14"
                           VerticalOptions="Center"
                           Margin="8,0"/>
                    
                    <Button Grid.Column="2"
                            ImageSource="{mi:Material Icon=Close, IconColor={StaticResource TextSecondary}}"
                            BackgroundColor="Transparent"
                            Command="{Binding ClearFiltersCommand}"
                            IsVisible="{Binding SearchText, Converter={StaticResource StringToBoolConverter}}"
                            VerticalOptions="Center"
                            MinimumWidthRequest="44"
                            MinimumHeightRequest="44"
                            Padding="0"
                            SemanticProperties.Description="Clear search"/>
                </Grid>
            </Border>

            <Border Padding="12,8"
                    StrokeThickness="0"
                    MinimumHeightRequest="44"
                    HorizontalOptions="Start"
                    BackgroundColor="{AppThemeBinding Light={StaticResource IconBackgroundBlue}, Dark={StaticResource IconBackgroundBlueDark}}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SyncLocationsCommand}"/>
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="4">
                    <Image WidthRequest="16" HeightRequest="16" VerticalOptions="Center">
                        <Image.Source>
                            <FontImageSource FontFamily="MaterialIcons-Regular"
                                           Glyph="{mi:Material Icon=Sync}"
                                           Color="{StaticResource AppBlue}"
                                           Size="16"/>
                        </Image.Source>
                    </Image>
                    <Label Text="Sync"
                           FontFamily="OpenSansSemibold"
                           FontSize="14"
                           TextColor="{StaticResource AppBlue}"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </Border>
        </VerticalStackLayout>

        <Grid Grid.Row="2">
            
            <ScrollView Margin="16,0"
                        IsVisible="{Binding IsBusy}">
                <controls:SkeletonListView Type="AssetItem" Count="8" ItemSpacing="0"/>
            </ScrollView>
            
            <RefreshView x:DataType="viewmodels:LocationsViewModel"
                         IsRefreshing="{Binding IsRefreshing}"
                         Command="{Binding RefreshCommand}"
                         RefreshColor="{StaticResource AppBlue}"
                         IsVisible="{Binding HasLocations}">
                <CollectionView x:DataType="viewmodels:LocationsViewModel"
                                ItemsSource="{Binding Locations}"
                                SelectionMode="None"
                                Margin="16,0"
                                ItemsUpdatingScrollMode="KeepScrollOffset"
                                RemainingItemsThreshold="5"
                                RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:LocationItemViewModel">
                            <Border Margin="0,8"
                                    Padding="0"
                                    StrokeThickness="0"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding TapCommand}"/>
                                </Border.GestureRecognizers>
                                
                                <Grid ColumnDefinitions="4,56,*,24"
                                      HeightRequest="80">
                                    
                                    <BoxView Grid.Column="0"
                                             Color="{StaticResource AppBlue}"/>
                                    
                                    <Border Grid.Column="1"
                                            WidthRequest="40"
                                            HeightRequest="40"
                                            StrokeThickness="0"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource IconBackgroundGreen}, Dark={StaticResource IconBackgroundGreenDark}}"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center"
                                            Margin="8,0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="20"/>
                                        </Border.StrokeShape>
                                        <Image WidthRequest="24"
                                               HeightRequest="24"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               mci:MauiIcon.Value="{mi:Material Icon={Binding LocationIcon}, IconColor={StaticResource SyncGreen}}"/>
                                    </Border>
                                    
                                    <VerticalStackLayout Grid.Column="2"
                                                         Padding="12,16"
                                                         Spacing="4"
                                                         VerticalOptions="Center">
                                        <Label Text="{Binding Name}"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="16"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1"/>
                                        
                                        <HorizontalStackLayout Spacing="4">
                                            <Label Text="{Binding DisplayAddress}"
                                                   FontSize="14"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                   LineBreakMode="TailTruncation"/>
                                            <Image WidthRequest="12" HeightRequest="12"
                                                   IsVisible="{Binding HasCoordinates}"
                                                   VerticalOptions="Center">
                                                <Image.Source>
                                                    <FontImageSource FontFamily="MaterialIcons-Regular"
                                                                   Glyph="{mi:Material Icon=GpsFixed}"
                                                                   Color="{StaticResource SyncGreen}"
                                                                   Size="12"/>
                                                </Image.Source>
                                            </Image>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                    
                                    <Image Grid.Column="3"
                                           WidthRequest="24"
                                           HeightRequest="24"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           Margin="0,0,8,0">
                                        <Image.Source>
                                            <FontImageSource FontFamily="MaterialIcons-Regular"
                                                           Glyph="{mi:Material Icon=ChevronRight}"
                                                           Color="{AppThemeBinding Light={StaticResource TextTertiary}, Dark={StaticResource TextTertiaryDark}}"
                                                           Size="24"/>
                                        </Image.Source>
                                    </Image>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    
                    <CollectionView.Footer>
                        <Grid Padding="16,12"
                              IsVisible="{Binding IsLoadingMore}"
                              HeightRequest="60">
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                                    Padding="16,12"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8">
                                <HorizontalStackLayout HorizontalOptions="Center"
                                                      VerticalOptions="Center"
                                                      Spacing="12">
                                    <ActivityIndicator IsRunning="True"
                                                     Color="{StaticResource AppBlue}"
                                                     WidthRequest="20"
                                                     HeightRequest="20"/>
                                    <Label Text="Loading more locations..."
                                           FontFamily="OpenSansRegular"
                                           FontSize="14"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>
                    </CollectionView.Footer>
                    
                </CollectionView>
            </RefreshView>

            <VerticalStackLayout IsVisible="{Binding ShowEmptyState}"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Spacing="16"
                                 Padding="32">
                <Image WidthRequest="64" HeightRequest="64" HorizontalOptions="Center">
                    <Image.Source>
                        <FontImageSource FontFamily="MaterialIcons-Regular"
                                       Glyph="{mi:Material Icon=LocationOff}"
                                       Color="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource Gray500}}"
                                       Size="64"/>
                    </Image.Source>
                </Image>
                
                <Label Text="No Locations Found"
                       FontFamily="OpenSansSemibold"
                       FontSize="18"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                       HorizontalOptions="Center"/>
                
                <Label Text="{Binding EmptyStateMessage}"
                       FontSize="14"
                       TextColor="{AppThemeBinding Light={StaticResource TextTertiary}, Dark={StaticResource TextTertiaryDark}}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>

        </Grid>

        <Button Grid.Row="2"
                ImageSource="{mi:Material Icon=Add, IconColor=White}"
                BackgroundColor="{StaticResource AppBlue}"
                CornerRadius="28"
                WidthRequest="56"
                HeightRequest="56"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="16"
                Command="{Binding AddLocationCommand}"
                Shadow="{StaticResource FABShadow}"
                SemanticProperties.Description="Add new location"/>

        <Grid Grid.Row="0" Grid.RowSpan="3"
              BackgroundColor="{StaticResource OverlayScrim}"
              IsVisible="{Binding IsCapturingLocation}">
            <VerticalStackLayout HorizontalOptions="Center"
                                VerticalOptions="Center"
                                Spacing="16">
                <ActivityIndicator IsRunning="True"
                                 Color="White"
                                 WidthRequest="48"
                                 HeightRequest="48"/>
                <Label Text="Capturing GPS location..."
                       FontFamily="OpenSansSemibold"
                       FontSize="16"
                       TextColor="White"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Grid>

    </Grid>
</ContentPage>
