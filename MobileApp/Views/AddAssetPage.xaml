<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MobileApp.ViewModels"
             xmlns:models="clr-namespace:Shared.Models;assembly=Shared"
             xmlns:converters="clr-namespace:MobileApp.Converters"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             x:Class="MobileApp.Views.AddAssetPage"
             x:Name="RootPage"
             x:DataType="viewmodels:AddAssetViewModel"
             Title="{Binding PageTitle}"
             BackgroundColor="#F8F9FA"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:NullableDateTimeConverter x:Key="NullableDateTimeConverter" />
            <converters:NullableDateDisplayConverter x:Key="NullableDateDisplayConverter" />
            <converters:IsNullConverter x:Key="IsNullConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="56,*,Auto">
        
        <!-- Top Header Bar -->
        <Frame Grid.Row="0" 
               BackgroundColor="#005A9C" 
               CornerRadius="0" 
               Padding="0"
               HasShadow="True">
            <Grid ColumnDefinitions="56,*,56" Padding="0">
                <!-- Back Button -->
                <Button Grid.Column="0"
                        ImageSource="{mi:Material Icon=ArrowBack, IconColor=White}"
                        BackgroundColor="Transparent"
                        Command="{Binding CancelCommand}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        WidthRequest="40"
                        HeightRequest="40"/>
                
                <!-- Title -->
                <Label Grid.Column="1"
                       Text="{Binding PageTitle}"
                       FontFamily="OpenSansSemibold"
                       FontSize="20"
                       TextColor="White"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
                
                <!-- Save Button -->
                <Button Grid.Column="2"
                        ImageSource="{mi:Material Icon=Save, IconColor=White}"
                        BackgroundColor="Transparent"
                        Command="{Binding SaveAssetCommand}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        WidthRequest="40"
                        HeightRequest="40"/>
            </Grid>
        </Frame>

        <!-- Form Content -->
        <ScrollView Grid.Row="1" Padding="16">
            <VerticalStackLayout Spacing="16">
                
                <!-- Digital Asset Tag with Scanner -->
                <Frame BackgroundColor="White"
                       CornerRadius="12"
                       Padding="16"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Digital Asset Tag (Optional)"
                               FontFamily="OpenSansSemibold"
                               FontSize="14"
                               TextColor="#333333"/>
                        
                        <!-- Entry with Scan Button -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Entry Grid.Column="0"
                                   Text="{Binding DigitalAssetTag}"
                                   Placeholder="Scan or enter digital tag"
                                   FontSize="14"
                                   BackgroundColor="#F8F9FA"
                                   TextColor="#333333"
                                   PlaceholderColor="#999999"
                                   HeightRequest="48"
                                   VerticalOptions="Center"/>
                            
                            <Button Grid.Column="1"
                                    ImageSource="{mi:Material Icon=QrCodeScanner, IconColor=White}"
                                    BackgroundColor="#005A9C"
                                    CornerRadius="8"
                                    WidthRequest="48"
                                    HeightRequest="48"
                                    Padding="12"
                                    Command="{Binding ScanBarcodeCommand}"
                                    ToolTipProperties.Text="Scan Barcode"/>
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- Asset Tag -->
                <Frame BackgroundColor="White" 
                       CornerRadius="12" 
                       Padding="16"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Asset Tag *"
                               FontFamily="OpenSansSemibold"
                               FontSize="14"
                               TextColor="#333333"/>
                        <Entry Text="{Binding AssetTag}"
                               Placeholder="e.g., AT-2024-001"
                               PlaceholderColor="#999999"
                               TextColor="#333333"
                               FontSize="16"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Asset Name -->
                <Frame BackgroundColor="White" 
                       CornerRadius="12" 
                       Padding="16"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Asset Name *"
                               FontFamily="OpenSansSemibold"
                               FontSize="14"
                               TextColor="#333333"/>
                        <Entry Text="{Binding Name}"
                               Placeholder="e.g., Dell Laptop"
                               PlaceholderColor="#999999"
                               TextColor="#333333"
                               FontSize="16"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Category Picker -->
                <Frame BackgroundColor="White" 
                       CornerRadius="12" 
                       Padding="16"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Category *"
                               FontFamily="OpenSansSemibold"
                               FontSize="14"
                               TextColor="#333333"/>
                        <Picker ItemsSource="{Binding Categories}"
                                SelectedItem="{Binding SelectedCategory}"
                                Title="Select Category"
                                TextColor="#333333"
                                FontSize="16">
                            <Picker.ItemDisplayBinding>
                                <Binding Path="Name" x:DataType="models:Category"/>
                            </Picker.ItemDisplayBinding>
                        </Picker>
                    </VerticalStackLayout>
                </Frame>

                <!-- Location Picker -->
                <Frame BackgroundColor="White" 
                       CornerRadius="12" 
                       Padding="16"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Location *"
                               FontFamily="OpenSansSemibold"
                               FontSize="14"
                               TextColor="#333333"/>

                        <Frame BackgroundColor="#F8F9FA"
                               BorderColor="#E5E7EB"
                               CornerRadius="10"
                               Padding="12"
                               HasShadow="False">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="{Binding SelectedLocationDisplay}"
                                       FontSize="16"
                                       TextColor="#333333"
                                       LineBreakMode="TailTruncation"/>
                                <Label Text="{Binding SelectedLocationContext}"
                                       FontSize="12"
                                       TextColor="#666666"
                                       LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                        </Frame>

                        <Button Text="Choose location"
                                Command="{Binding OpenLocationPickerCommand}"
                                BackgroundColor="#005A9C"
                                TextColor="White"
                                CornerRadius="8"
                                HeightRequest="44"
                                FontFamily="OpenSansSemibold"/>

                        <Label Text="No locations available. Add one to continue."
                               FontSize="12"
                               TextColor="#C62828">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding HasLocations}" Value="True">
                                    <Setter Property="IsVisible" Value="False"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>

                        <Button Text="Add location"
                                Command="{Binding AddLocationCommand}"
                                BackgroundColor="#E3F2FD"
                                TextColor="#005A9C"
                                CornerRadius="8"
                                HeightRequest="40">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding HasLocations}" Value="True">
                                    <Setter Property="IsVisible" Value="False"/>
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </VerticalStackLayout>
                </Frame>

                <!-- Department Picker -->
                <Frame BackgroundColor="White" 
                       CornerRadius="12" 
                       Padding="16"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Department *"
                               FontFamily="OpenSansSemibold"
                               FontSize="14"
                               TextColor="#333333"/>
                        <Picker ItemsSource="{Binding Departments}"
                                SelectedItem="{Binding SelectedDepartment}"
                                Title="Select Department"
                                TextColor="#333333"
                                FontSize="16">
                            <Picker.ItemDisplayBinding>
                                <Binding Path="Name" x:DataType="models:Department"/>
                            </Picker.ItemDisplayBinding>
                        </Picker>
                    </VerticalStackLayout>
                </Frame>

                <!-- Status Picker -->
                <Frame BackgroundColor="White" 
                       CornerRadius="12" 
                       Padding="16"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Status *"
                               FontFamily="OpenSansSemibold"
                               FontSize="14"
                               TextColor="#333333"/>
                        <Picker ItemsSource="{Binding StatusOptions}"
                                SelectedItem="{Binding SelectedStatus}"
                                Title="Select Status"
                                TextColor="#333333"
                                FontSize="16"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Condition Picker -->
                <Frame BackgroundColor="White" 
                       CornerRadius="12" 
                       Padding="16"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Condition *"
                               FontFamily="OpenSansSemibold"
                               FontSize="14"
                               TextColor="#333333"/>
                        <Picker ItemsSource="{Binding ConditionOptions}"
                                SelectedItem="{Binding SelectedCondition}"
                                Title="Select Condition"
                                TextColor="#333333"
                                FontSize="16"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Description -->
                <Frame BackgroundColor="White"
                       CornerRadius="12"
                       Padding="16"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Description (Optional)"
                               FontFamily="OpenSansSemibold"
                               FontSize="14"
                               TextColor="#333333"/>
                        <Editor Text="{Binding Description}"
                                Placeholder="Additional details about this asset..."
                                PlaceholderColor="#999999"
                                TextColor="#333333"
                                FontSize="16"
                                HeightRequest="100"
                                AutoSize="TextChanges"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Purchase Date and Serial Number -->
                <Frame BackgroundColor="White"
                       CornerRadius="12"
                       Padding="16"
                       HasShadow="True">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12">
                        <!-- Purchase Date -->
                        <VerticalStackLayout Grid.Row="0" Spacing="8">
                            <Label Text="Purchase Date (Optional)"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="14"
                                   TextColor="#333333"/>
                            <Grid>
                                <DatePicker Date="{Binding PurchaseDate, Converter={StaticResource NullableDateTimeConverter}}"
                                           Format="yyyy-MM-dd"
                                           TextColor="#333333"
                                           FontSize="16"
                                           BackgroundColor="#F8F9FA"
                                           Opacity="0"/>
                                <Label Text="{Binding PurchaseDate, Converter={StaticResource NullableDateDisplayConverter}}"
                                       FontSize="16"
                                       TextColor="{Binding PurchaseDate, Converter={StaticResource IsNullConverter}}"
                                       VerticalOptions="Center"
                                       Margin="12,0,0,0"
                                       InputTransparent="True"/>
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Serial Number -->
                        <VerticalStackLayout Grid.Row="1" Spacing="8">
                            <Label Text="Serial Number (Optional)"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="14"
                                   TextColor="#333333"/>
                            <Entry Text="{Binding SerialNumber}"
                                   Placeholder="e.g., SN123456789"
                                   PlaceholderColor="#999999"
                                   TextColor="#333333"
                                   FontSize="16"/>
                        </VerticalStackLayout>
                    </Grid>
                </Frame>

                <!-- Financial Information Section Header -->
                <Label Text="Financial Information"
                       FontFamily="OpenSansSemibold"
                       FontSize="16"
                       TextColor="#005A9C"
                       Margin="0,8,0,0"/>

                <!-- Purchase Price and Quantity -->
                <Frame BackgroundColor="White"
                       CornerRadius="12"
                       Padding="16"
                       HasShadow="True">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12">
                        <!-- Purchase Price -->
                        <VerticalStackLayout Grid.Row="0" Spacing="8">
                            <Label Text="Purchase Price (Optional)"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="14"
                                   TextColor="#333333"/>
                            <Entry Text="{Binding PurchasePrice}"
                                   Placeholder="0.00"
                                   Keyboard="Numeric"
                                   PlaceholderColor="#999999"
                                   TextColor="#333333"
                                   FontSize="16"/>
                        </VerticalStackLayout>

                        <!-- Quantity -->
                        <VerticalStackLayout Grid.Row="1" Spacing="8">
                            <Label Text="Quantity"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="14"
                                   TextColor="#333333"/>
                            <Entry Text="{Binding Quantity}"
                                   Placeholder="1"
                                   Keyboard="Numeric"
                                   PlaceholderColor="#999999"
                                   TextColor="#333333"
                                   FontSize="16"/>
                        </VerticalStackLayout>

                        <!-- Cost Per Unit -->
                        <VerticalStackLayout Grid.Row="2" Spacing="8">
                            <Label Text="Cost Per Unit (Optional)"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="14"
                                   TextColor="#333333"/>
                            <Entry Text="{Binding CostPerUnit}"
                                   Placeholder="0.00"
                                   Keyboard="Numeric"
                                   PlaceholderColor="#999999"
                                   TextColor="#333333"
                                   FontSize="16"/>
                        </VerticalStackLayout>
                    </Grid>
                </Frame>

                <!-- Additional Information Section Header -->
                <Label Text="Additional Information"
                       FontFamily="OpenSansSemibold"
                       FontSize="16"
                       TextColor="#005A9C"
                       Margin="0,8,0,0"/>

                <!-- Vendor and Invoice -->
                <Frame BackgroundColor="White"
                       CornerRadius="12"
                       Padding="16"
                       HasShadow="True">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
                        <!-- Vendor Name -->
                        <VerticalStackLayout Grid.Row="0" Spacing="8">
                            <Label Text="Vendor Name (Optional)"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="14"
                                   TextColor="#333333"/>
                            <Entry Text="{Binding VendorName}"
                                   Placeholder="e.g., Dell Inc."
                                   PlaceholderColor="#999999"
                                   TextColor="#333333"
                                   FontSize="16"/>
                        </VerticalStackLayout>

                        <!-- Invoice Number -->
                        <VerticalStackLayout Grid.Row="1" Spacing="8">
                            <Label Text="Invoice Number (Optional)"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="14"
                                   TextColor="#333333"/>
                            <Entry Text="{Binding InvoiceNumber}"
                                   Placeholder="e.g., INV-2024-001"
                                   PlaceholderColor="#999999"
                                   TextColor="#333333"
                                   FontSize="16"/>
                        </VerticalStackLayout>
                    </Grid>
                </Frame>

                <!-- Warranty and Disposal -->
                <Frame BackgroundColor="White"
                       CornerRadius="12"
                       Padding="16"
                       HasShadow="True">
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                        <!-- Warranty Expiry -->
                        <VerticalStackLayout Grid.Row="0" Spacing="8">
                            <Label Text="Warranty Expiry (Optional)"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="14"
                                   TextColor="#333333"/>
                            <Grid>
                                <DatePicker Date="{Binding WarrantyExpiry, Converter={StaticResource NullableDateTimeConverter}}"
                                           Format="yyyy-MM-dd"
                                           TextColor="#333333"
                                           FontSize="16"
                                           BackgroundColor="#F8F9FA"
                                           Opacity="0"/>
                                <Label Text="{Binding WarrantyExpiry, Converter={StaticResource NullableDateDisplayConverter}}"
                                       FontSize="16"
                                       TextColor="{Binding WarrantyExpiry, Converter={StaticResource IsNullConverter}}"
                                       VerticalOptions="Center"
                                       Margin="12,0,0,0"
                                       InputTransparent="True"/>
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Disposal Date -->
                        <VerticalStackLayout Grid.Row="1" Spacing="8">
                            <Label Text="Disposal Date (Optional)"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="14"
                                   TextColor="#333333"/>
                            <Grid>
                                <DatePicker Date="{Binding DisposalDate, Converter={StaticResource NullableDateTimeConverter}}"
                                           Format="yyyy-MM-dd"
                                           TextColor="#333333"
                                           FontSize="16"
                                           BackgroundColor="#F8F9FA"
                                           Opacity="0"/>
                                <Label Text="{Binding DisposalDate, Converter={StaticResource NullableDateDisplayConverter}}"
                                       FontSize="16"
                                       TextColor="{Binding DisposalDate, Converter={StaticResource IsNullConverter}}"
                                       VerticalOptions="Center"
                                       Margin="12,0,0,0"
                                       InputTransparent="True"/>
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Disposal Value -->
                        <VerticalStackLayout Grid.Row="2" Spacing="8">
                            <Label Text="Disposal Value (Optional)"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="14"
                                   TextColor="#333333"/>
                            <Entry Text="{Binding DisposalValue}"
                                   Placeholder="0.00"
                                   Keyboard="Numeric"
                                   PlaceholderColor="#999999"
                                   TextColor="#333333"
                                   FontSize="16"/>
                        </VerticalStackLayout>
                    </Grid>
                </Frame>

                <!-- Remarks -->
                <Frame BackgroundColor="White"
                       CornerRadius="12"
                       Padding="16"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Remarks (Optional)"
                               FontFamily="OpenSansSemibold"
                               FontSize="14"
                               TextColor="#333333"/>
                        <Editor Text="{Binding Remarks}"
                                Placeholder="Additional notes or comments..."
                                PlaceholderColor="#999999"
                                TextColor="#333333"
                                FontSize="16"
                                HeightRequest="80"
                                AutoSize="TextChanges"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Required Fields Note -->
                <Label Text="* Required fields"
                       FontSize="12"
                       TextColor="#999999"
                       HorizontalOptions="Start"
                       Margin="4,0,0,0"/>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom Action Buttons -->
        <Grid Grid.Row="2" 
              ColumnDefinitions="*,*" 
              ColumnSpacing="12"
              Padding="16"
              BackgroundColor="White">
            <Border Grid.Column="0"
                    StrokeThickness="0">
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.1" Radius="8" Offset="0,-2"/>
                </Border.Shadow>
            </Border>
            
            <Button Grid.Column="0"
                    Text="Cancel"
                    BackgroundColor="#6C757D"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="50"
                    FontFamily="OpenSansSemibold"
                    Command="{Binding CancelCommand}"/>
            
            <Button Grid.Column="1"
                    Text="{Binding SaveButtonText}"
                    BackgroundColor="#005A9C"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="50"
                    FontFamily="OpenSansSemibold"
                    Command="{Binding SaveAssetCommand}"/>
        </Grid>

        <!-- Busy Overlay -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              BackgroundColor="#80000000"
              IsVisible="{Binding IsBusy}">
            <VerticalStackLayout HorizontalOptions="Center"
                                VerticalOptions="Center"
                                Spacing="16">
                <ActivityIndicator IsRunning="True"
                                 Color="White"
                                 WidthRequest="48"
                                 HeightRequest="48"/>
                <Label Text="{Binding BusyMessage}"
                       FontFamily="OpenSansSemibold"
                       FontSize="16"
                       TextColor="White"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Grid>

        <!-- Location Selection Overlay -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              IsVisible="{Binding IsLocationPickerOpen}"
              BackgroundColor="#99000000">
            <Frame BackgroundColor="White"
                   CornerRadius="16"
                   Margin="16,64,16,16"
                   Padding="16"
                   HasShadow="True">
                <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Text="Select Location"
                               FontFamily="OpenSansSemibold"
                               FontSize="18"
                               TextColor="#333333"
                               VerticalOptions="Center"/>
                        <Button Grid.Column="1"
                                ImageSource="{mi:Material Icon=Close, IconColor=#666666}"
                                BackgroundColor="Transparent"
                                Command="{Binding CloseLocationPickerCommand}"
                                WidthRequest="32"
                                HeightRequest="32"/>
                    </Grid>

                    <SearchBar Grid.Row="1"
                               Placeholder="Search by name, campus, building, room..."
                               Text="{Binding LocationSearchText}"
                               TextColor="#333333"
                               PlaceholderColor="#888888"
                               CancelButtonColor="#005A9C"
                               FontSize="14"/>

                    <CollectionView Grid.Row="2"
                                    ItemsSource="{Binding FilteredLocations}"
                                    SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Location">
                                <Frame Padding="12"
                                       Margin="0,0,0,8"
                                       CornerRadius="10"
                                       BorderColor="#E5E7EB"
                                       HasShadow="False">
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="LocationResult_Tapped"/>
                                    </Frame.GestureRecognizers>
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding Name}"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="15"
                                               TextColor="#333333"/>
                                        <Label FontSize="13"
                                               TextColor="#666666"
                                               LineBreakMode="TailTruncation">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Campus}"/>
                                                    <Span Text=" | "/>
                                                    <Span Text="{Binding Building}"/>
                                                    <Span Text=" | Room "/>
                                                    <Span Text="{Binding Room}"/>
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <Label Text="{Binding Description}"
                                               FontSize="12"
                                               TextColor="#888888"
                                               LineBreakMode="TailTruncation"/>
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Label Grid.Row="2"
                           IsVisible="True"
                           Text="No matching locations found."
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           InputTransparent="True"
                           FontSize="13"
                           TextColor="#666666">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding HasFilteredLocations}" Value="True">
                                <Setter Property="IsVisible" Value="False"/>
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>

                    <Button Grid.Row="3"
                            Text="Close"
                            Command="{Binding CloseLocationPickerCommand}"
                            BackgroundColor="#F3F4F6"
                            TextColor="#333333"
                            CornerRadius="8"
                            HeightRequest="44"/>
                </Grid>
            </Frame>
        </Grid>

    </Grid>
</ContentPage>