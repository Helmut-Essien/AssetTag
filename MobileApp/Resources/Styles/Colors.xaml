<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <Color x:Key="Primary">#512BD4</Color>
    <Color x:Key="PrimaryDark">#ac99ea</Color>
    <Color x:Key="PrimaryDarkText">#242424</Color>
    <Color x:Key="Secondary">#DFD8F7</Color>
    <Color x:Key="SecondaryDarkText">#9880e5</Color>
    <Color x:Key="Tertiary">#2B0B98</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>
    
    <Color x:Key="BrandGreen">#7CB342</Color>
    <Color x:Key="DarkBackground">#1a1a1a</Color>

    <!-- AssetTag semantic tokens -->
    <Color x:Key="AppBlue">#005A9C</Color>
    <Color x:Key="SyncGreen">#4CAF50</Color>
    <Color x:Key="SyncOrange">#FF9800</Color>
    <Color x:Key="SyncRed">#F44336</Color>
    <Color x:Key="PendingText">#E65100</Color>
    <Color x:Key="PendingTextDark">#FFB74D</Color>
    <Color x:Key="ErrorBackground">#FFEBEE</Color>
    <Color x:Key="ErrorBackgroundDark">#3E1A1A</Color>
    <Color x:Key="ErrorBorder">#EF5350</Color>
    <Color x:Key="ErrorText">#C62828</Color>
    <Color x:Key="ErrorTextDark">#EF9A9A</Color>
    <Color x:Key="CancelGray">#6C757D</Color>
    <Color x:Key="DangerRed">#DC3545</Color>
    <Color x:Key="OverlayScrim">#80000000</Color>

    <Color x:Key="PageBackground">#F8F9FA</Color>
    <Color x:Key="PageBackgroundDark">#1f1f1f</Color>
    <Color x:Key="CardBackground">#FFFFFF</Color>
    <Color x:Key="CardBackgroundDark">#2a2a2a</Color>
    <Color x:Key="TextPrimary">#333333</Color>
    <Color x:Key="TextPrimaryDark">#FFFFFF</Color>
    <Color x:Key="TextSecondary">#666666</Color>
    <Color x:Key="TextSecondaryDark">#C8C8C8</Color>
    <Color x:Key="TextTertiary">#999999</Color>
    <Color x:Key="TextTertiaryDark">#919191</Color>
    <Color x:Key="TextMuted">#CCCCCC</Color>
    <Color x:Key="ChipInactive">#E0E0E0</Color>
    <Color x:Key="ChipInactiveDark">#404040</Color>
    <Color x:Key="IconBackgroundBlue">#E3F2FD</Color>
    <Color x:Key="IconBackgroundBlueDark">#1A3A52</Color>
    <Color x:Key="IconBackgroundGreen">#E8F5E9</Color>
    <Color x:Key="IconBackgroundGreenDark">#1B3A1F</Color>
    <Color x:Key="IconBackgroundOrange">#FFF3E0</Color>
    <Color x:Key="IconBackgroundOrangeDark">#3E2E1A</Color>
    <Color x:Key="IconBackgroundRed">#FFEBEE</Color>
    <Color x:Key="IconBackgroundIndigo">#E8EAF6</Color>
    <Color x:Key="IconBackgroundIndigoDark">#1E1F3A</Color>
    <Color x:Key="IconBackgroundAmber">#FFF8E1</Color>
    <Color x:Key="IconBackgroundAmberDark">#3E351A</Color>
    <Color x:Key="BorderSubtle">#EEEEEE</Color>
    <Color x:Key="BorderSubtleDark">#404040</Color>
    <Color x:Key="InputFill">#F8F9FA</Color>
    <Color x:Key="InputFillDark">#333333</Color>
    <Color x:Key="SwitchOff">#BDBDBD</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="BrandGreenBrush" Color="{StaticResource BrandGreen}"/>
    <SolidColorBrush x:Key="DarkBackgroundBrush" Color="{StaticResource DarkBackground}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>